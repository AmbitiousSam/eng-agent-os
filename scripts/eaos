#!/usr/bin/env python3
"""
eaos — deterministic bookkeeping runtime for the Engineering Agentic OS.

Moves the kernel's mechanical rules (task ids, war-room appends, loop ceilings, spawn
budget, gates, DoD verification, final-report assembly) from prompt-enforcement to code.
State lives under ./.eaos/ in the target project (cwd). Two files per task:
  warroom.md   — human-readable, append-only log (byproduct, not parsed back)
  state.json   — machine state: source of truth for every command below

Exit codes: 0 = allowed/ok, 1 = ceiling hit / gate unmet / invalid / task BLOCKED,
2 = usage error, 3 = CONDITIONAL (verify --require only: no failed criteria, but at
least one conditional criterion remains — see §11 and the criterion-state comment below),
4 = INFRASTRUCTURE (lock contention/timeout — nothing was mutated, retry; never a policy
verdict, so a host hook must fail OPEN on it, review round 4 HIGH-2).
stdlib only (json/argparse/os/re/datetime/hashlib/time/contextlib). No third-party
deps, ever.

Consistency layer (spec §11): state.json carries schema_version + revision; mutating
verbs serialize through a per-task lock (.eaos/<id>/.lock) or, when a mutation touches
project-wide state (config.json, runs.jsonl, or a cross-task spawn-budget scan), a
project lock (.eaos/.lock) — always acquired before any task lock to avoid deadlock.
"""
import argparse
import contextlib
import datetime
import fnmatch
import hashlib
import json
import os
import re
import subprocess
import sys
import time

MSG_TYPES = ["PROPOSE", "QUESTION", "CHALLENGE", "REVIEW", "RISK", "DECISION", "HANDOFF",
             "STATUS", "VERDICT"]
DEFAULT_CONFIG = {
    "max_same_issue_loops": 3,
    "max_total_loopbacks": 8,
    # 15 = 12 planning slots (unchanged from before) + 2 loop-back slots + 1 verifier slot.
    # Real run 2026-09-09: rosters were planned to exactly 12 with zero slack, so every
    # loop-back ate an independent role (security re-review, code re-review, tech-writer,
    # the verifier's own re-grade) — the budget was treated as the law and maker/checker
    # isolation as the flex. Reserves invert that: the budget can run out of makers,
    # never out of an independent checker.
    "max_agent_spawns_per_task": 15,
    # Top slot(s): only a verifier may take them (T-001 msg-039 — orchestrator applied the
    # verifier's fix AND re-graded it itself).
    "reserved_verifier_spawns": 1,
    # Next slot(s): open only after a loop-back has been recorded on the task (or to a
    # verifier). Planning a roster into them is refused — that is the zero-slack blunder.
    "reserved_loopback_spawns": 2,
    # v4 (spec sections 5-9): which check categories a build unit must evidence before a
    # READY handoff; board view budgets in tokens; advisory context ceiling for the lead;
    # ignored-but-relevant paths that count toward the code snapshot.
    "required_checks": ["test"],
    "board_view_budget": {"lead": 1500, "unit": 1500, "checker": 2500, "packet": 800},
    "max_context_tokens": 150000,
    "snapshot_extra_paths": [],
    # Untracked paths that are never product inputs even when a repo forgot to ignore
    # them (a test run creating __pycache__ must not read as a code change).
    "snapshot_ignore_globs": ["__pycache__", "*.pyc", ".pytest_cache", ".mypy_cache",
                              ".ruff_cache", "node_modules", ".tox", ".venv", "venv",
                              ".DS_Store", "*.egg-info"],
}
VERIFIER_AGENT_RE = re.compile(r"verifier", re.I)
CHECKER_ROLE_RE = re.compile(r"\b(security|review\w*|verif\w*|qa)\b", re.I)

# Evidence that reads like a deferral cannot back a `verified` verdict (real run
# 2026-09-09, T-002: five criteria stored as verified with evidence "HUMAN-RUN ... pending"
# and "SUPERSEDED ... satisfied-by-supersession", so `verify --require` exited 0 and the
# report claimed complete). The canonical verdicts for those cases exist; use them.
RISK_SEVERITIES = {"low": "low", "med": "medium", "medium": "medium", "high": "high",
                   "critical": "blocking", "blocking": "blocking", "blocker": "blocking"}
RISK_REGISTERED_SEVERITIES = ("high", "blocking")
RISK_BODY_SEVERITY_RE = re.compile(
    r"\bsever\w*\s*[:=-]?\s*(low|med|medium|high|critical|blocking|blocker)\b", re.I)

def resolve_risk_severity(flag, priority, body):
    """--severity wins; then the body; then legacy priority words. `priority: blocking`
    can only raise the result, never lower it."""
    sev = None
    if flag:
        # An explicit flag WINS or FAILS — it never falls through. `--severity hihg
        # --priority low` used to be accepted as low (review 3, finding 2).
        sev = RISK_SEVERITIES.get(str(flag).lower())
        if sev is None:
            die(f"append: invalid --severity '{flag}' — use low|medium|high|blocking", 2)
    if sev is None:
        m = RISK_BODY_SEVERITY_RE.search(body or "")
        if m:
            sev = RISK_SEVERITIES[m.group(1).lower()]
    if sev is None:
        sev = RISK_SEVERITIES.get(str(priority or "").lower())
    if str(priority or "").lower() == "blocking":
        sev = "blocking"
    return sev

DEFERRAL_EVIDENCE_RE = re.compile(
    r"\b(pending|human[- ]run|supersed\w*|skip(ped|s)?|not (yet )?(run|executed|tested|"
    r"exercised|verified)|cannot be (run|verified|tested)|deferred|out of scope|"
    r"manual(ly)? (confirm\w*|run)|to be (run|verified|tested)|would (pass|succeed))\b", re.I)

def reject_deferral_evidence(criterion, verdict, evidence):
    if verdict == "verified" and DEFERRAL_EVIDENCE_RE.search(evidence or ""):
        m = DEFERRAL_EVIDENCE_RE.search(evidence).group(0)
        die(f"verify: {criterion} — evidence reads like a deferral ('{m}') but the verdict is "
            f"'verified'. A criterion that was not executed is not verified: use "
            f"manual_confirmation_required (awaits a human run), blocked, or "
            f"not_reproducible; a superseded criterion is graded under its successor and "
            f"dropped, not passed", 2)

STATE_SCHEMA_VERSION = 2
IDEMPOTENCY_KEEP = 200

# Canonical criterion-verdict enum (spec §11). "pass"/"fail" are accepted as INPUT
# aliases only (legacy callers, --verdict and --bulk lines) — they are canonicalized to
# verified/failed before anything is persisted; state.json never stores the alias form.
CANONICAL_VERDICTS = ("verified", "failed", "blocked", "not_reproducible",
                       "manual_confirmation_required")
VERDICT_ALIASES = {"pass": "verified", "fail": "failed"}
VERIFY_VERDICTS = CANONICAL_VERDICTS + tuple(VERDICT_ALIASES)  # accepted CLI/bulk input

def canonicalize_verdict(v):
    return VERDICT_ALIASES.get(v, v)

# Criterion states beyond verified/failed: honest deferral rather than a fantasy pass
# (spec §11; evidence: T17-09 AC2). These never block --require with exit 1, only mark
# it CONDITIONAL (exit 3) — but manual_confirmation_required and blocked/not_reproducible
# carry different honesty semantics (fix 2): the former means the implementation may be
# complete and release is pending a human's confirmation; the latter two mean the
# implementation itself is NOT claimed complete — the criterion is unresolved.
CONDITIONAL_VERDICTS = ("blocked", "not_reproducible", "manual_confirmation_required")
UNRESOLVED_VERDICTS = ("blocked", "not_reproducible")
MANUAL_CONFIRMATION_VERDICT = "manual_confirmation_required"

LOOPBACK_CLASSES = ("recoverable", "transient", "hard_blocker")

LOCK_STALE_SECONDS = 60
EXIT_INFRA = 4   # lock contention/timeout: not a verdict (see module docstring)
SESSION_BIND_FRESH_SECONDS = 300   # `session bind --fresh`: task must be this recent
LOCK_TIMEOUT_SECONDS = 2.0
LOCK_POLL_SECONDS = 0.05

# ---------- small io helpers ----------

def now_iso():
    return datetime.datetime.now().isoformat(timespec="seconds")

def die(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)

def eaos_dir():
    return os.path.join(os.getcwd(), ".eaos")

def config_path():
    return os.path.join(eaos_dir(), "config.json")

def load_config():
    p = config_path()
    if not os.path.isfile(p):
        die("config.json not found — run `eaos init` first", 2)
    with open(p, encoding="utf-8") as f:
        return json.load(f)

def task_dir(task_id):
    d = os.path.join(eaos_dir(), task_id)
    if not os.path.isdir(d):
        die(f"no such task: {task_id}", 2)
    return d

def state_path(task_id):
    return os.path.join(task_dir(task_id), "state.json")

def warroom_path(task_id):
    return os.path.join(task_dir(task_id), "warroom.md")

def migrate_state(state):
    """Tolerate a pre-v2 state.json: fill missing fields in-memory. The bump to
    schema_version 2 is only committed to disk on the next save_state() call."""
    if state.get("schema_version", 1) < 2:
        state.setdefault("revision", 0)
        state.setdefault("parent", None)
        state.setdefault("fingerprint", None)
        state.setdefault("idempotency_keys", [])
        state["schema_version"] = 2
    # Canonicalize legacy pass/fail criterion verdicts (fix 3) regardless of
    # schema_version — a state file may carry them even under v2 if it was written
    # before this canonicalization existed. In-memory only until the next save_state().
    for v in state.get("criteria", {}).values():
        verdict = v.get("verdict")
        if verdict in VERDICT_ALIASES:
            v["verdict"] = VERDICT_ALIASES[verdict]
    return state

def load_state(task_id):
    p = state_path(task_id)
    if not os.path.isfile(p):
        die(f"no state.json for task: {task_id}", 2)
    with open(p, encoding="utf-8") as f:
        state = json.load(f)
    return migrate_state(state)

def revisions_path(task_id):
    return os.path.join(task_dir(task_id), "revisions.jsonl")

def save_state(task_id, state):
    # atomic: write to a sibling temp file, then rename over the real one — a crash
    # mid-write leaves the previous-valid state.json, never a partial/corrupt one.
    state["schema_version"] = STATE_SCHEMA_VERSION
    state["revision"] = state.get("revision", 0) + 1
    # Genesis marker: once any save_state has run, this task HAS a journal. Audit (l)
    # then treats a missing/empty revisions.jsonl as deleted history, not as a legacy
    # pre-journal task (review round 4 medium-1).
    state["journal_enabled"] = True
    # First journaled revision, fixed forever: audit (l) requires the journal's first line
    # to carry exactly this revision, so deleting the HEAD of revisions.jsonl is detected
    # (review round 5 item 3) — not just tail truncation.
    state.setdefault("journal_start_revision", state["revision"])
    p = state_path(task_id)
    tmp = f"{p}.tmp.{os.getpid()}"
    payload = json.dumps(state, indent=2) + "\n"
    payload_bytes = payload.encode("utf-8")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(payload)
    os.replace(tmp, p)

    # Revision journal (spec §11 / audit check l): one JSON line per save_state call,
    # appended under the SAME task lock the caller already holds — this function never
    # acquires a lock of its own. A task that predates the journal simply gets its first
    # line the moment its next mutation runs, seeded at whatever revision that mutation
    # lands on (audit reports that as "journal started at revision N", not a
    # discrepancy). Single os.write append — cheap, and matches the runs.jsonl append
    # style elsewhere in this file. Per-task and bounded by that task's own mutation
    # count; no rotation needed.
    entry = {
        "revision": state["revision"],
        "at": now_iso(),
        "state_sha256": hashlib.sha256(payload_bytes).hexdigest(),
    }
    line = (json.dumps(entry) + "\n").encode("utf-8")
    fd = os.open(revisions_path(task_id), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, line)
    finally:
        os.close(fd)

    # Project-level head anchor (round 5 item 3): the same (revision, sha) is appended
    # OUTSIDE the task directory, so a coordinated rollback of state.json + revisions.jsonl
    # inside .eaos/<id>/ no longer agrees with anything — audit (n) compares the task's
    # latest head here against the live state. A rollback that also rewrites this file
    # is out of scope (that needs an anchor outside the checkout, e.g. git or a remote);
    # the claim is "out-of-band edits and corruption are detected", not tamper-proofing.
    head = {"task": task_id, "revision": state["revision"],
            "state_sha256": entry["state_sha256"], "at": entry["at"]}
    hline = (json.dumps(head) + "\n").encode("utf-8")
    fd = os.open(heads_path(), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, hline)
    finally:
        os.close(fd)

def heads_path():
    return os.path.join(eaos_dir(), "heads.jsonl")

def lock_events_path():
    return os.path.join(eaos_dir(), "lock-events.jsonl")

def read_heads_for_task(task_id):
    p = heads_path()
    out = []
    if not os.path.isfile(p):
        return out
    with open(p, encoding="utf-8") as f:
        for raw in f:
            raw = raw.strip()
            if not raw:
                continue
            try:
                obj = json.loads(raw)
            except json.JSONDecodeError:
                continue
            if obj.get("task") == task_id:
                out.append(obj)
    return out

def read_lock_events():
    p = lock_events_path()
    out = []
    if not os.path.isfile(p):
        return out
    with open(p, encoding="utf-8") as f:
        for raw in f:
            raw = raw.strip()
            if not raw:
                continue
            try:
                out.append(json.loads(raw))
            except json.JSONDecodeError:
                continue
    return out

def next_seq(state):
    """The revision the pending save_state() will write. Used as a persisted, monotonic
    event sequence: wall-clock timestamps have one-second resolution, so two consecutive
    CLI calls routinely share one and cannot be ordered by it."""
    return int(state.get("revision", 0) or 0) + 1

def warroom_log(task_id, line):
    with open(warroom_path(task_id), "a", encoding="utf-8") as f:
        f.write(line if line.endswith("\n") else line + "\n")

def read_warroom_text(task_id):
    p = warroom_path(task_id)
    if not os.path.isfile(p):
        return ""
    with open(p, encoding="utf-8") as f:
        return f.read()

def runs_path():
    return os.path.join(eaos_dir(), "runs.jsonl")

# ---------- CURRENT (legacy single-session pointer — M-007 / spec §11) ----------
# .eaos/CURRENT names the most recently created task: `task new` points it there;
# `episode close` clears it once that same task closes. Hooks resolve their task through
# the SESSION map below (resolve_hook_task) and only fall back to CURRENT when it is
# unambiguous; `eaos status` with no id still reads it. It is advisory bookkeeping (like everything else in this
# file, the wrapper remains the authoritative mutation path) — a plain text file holding
# one task id, written atomically the same way state.json is.

def current_path():
    return os.path.join(eaos_dir(), "CURRENT")

def read_current():
    p = current_path()
    if not os.path.isfile(p):
        return None
    with open(p, encoding="utf-8") as f:
        val = f.read().strip()
    return val or None

def write_current(task_id):
    p = current_path()
    tmp = f"{p}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(task_id + "\n")
    os.replace(tmp, p)

def clear_current_if_matches(task_id):
    if read_current() == task_id:
        try:
            os.remove(current_path())
        except OSError:
            pass

# ---------- session-scoped task pointers (review round 4 HIGH-4) ----------
# .eaos/sessions/<session-id> maps ONE host session to the task it is working on. A hook
# resolves its task through this map (from the host payload's session_id) — never
# through the global CURRENT alone — so two sessions in one checkout cannot attribute
# each other's spawns/audits. Written by `task new --session` (or $EAOS_SESSION_ID) and
# `session bind`; retargeted to the parent task (if still active) or removed by
# `episode close`. Temp files start with '.' so they can never match SESSION_ID_RE.
SESSION_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")

def sessions_dir():
    return os.path.join(eaos_dir(), "sessions")

def check_session_id(sid):
    if not SESSION_ID_RE.match(sid or ""):
        die("invalid session id (allowed [A-Za-z0-9._-], 1-128 chars, no leading '.')", 2)
    return sid

def session_map_path(sid):
    return os.path.join(sessions_dir(), check_session_id(sid))

def read_session_map(sid):
    p = session_map_path(sid)
    if not os.path.isfile(p):
        return None
    with open(p, encoding="utf-8") as f:
        val = f.read().strip()
    return val or None

def write_session_map(sid, task_id):
    os.makedirs(sessions_dir(), exist_ok=True)
    p = session_map_path(sid)
    tmp = os.path.join(sessions_dir(), f".{sid}.tmp.{os.getpid()}")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(task_id + "\n")
    os.replace(tmp, p)

def remove_session_map(sid):
    try:
        os.remove(session_map_path(sid))
    except OSError:
        pass

def all_session_maps():
    d = sessions_dir()
    if not os.path.isdir(d):
        return {}
    out = {}
    for name in sorted(os.listdir(d)):
        if not SESSION_ID_RE.match(name):
            continue
        with open(os.path.join(d, name), encoding="utf-8") as f:
            val = f.read().strip()
        if val:
            out[name] = val
    return out

def active_task_ids():
    out = []
    for tid in all_task_ids():
        try:
            if load_state(tid).get("status") != "closed":
                out.append(tid)
        except SystemExit:
            continue
    return out

def retarget_session_maps_on_close(task_id, parent):
    """episode close: every session pointing at the closing task is re-pointed to its
    parent when that parent is still active (the session continues parent work), else
    removed. Sessions bound to other tasks are never touched."""
    parent_active = False
    if parent:
        try:
            parent_active = load_state(parent).get("status") != "closed"
        except SystemExit:
            parent_active = False
    for sid, tid in all_session_maps().items():
        if tid != task_id:
            continue
        if parent_active:
            write_session_map(sid, parent)
        else:
            remove_session_map(sid)

def resolve_hook_task(sid):
    """The ONE rule a host hook uses to find its task. Returns (task_id, reason):
      1. sid given and .eaos/sessions/<sid> names an ACTIVE task -> that task
         (a mapping to a closed/missing task is stale: dropped, then fall through).
      2. sid given, no mapping -> None. NEVER adopt an unclaimed task: "the only active
         task" may belong to a session that simply has no binder installed, and adopting
         it would attribute this session's spawns to it — and block this session on the
         other one's budget (review round 5 item 1). Binding happens only explicitly:
         `session bind --fresh` from the PostToolUse binder, `task new --session`, or
         $EAOS_SESSION_ID.
      3. no sid (host without session ids): .eaos/CURRENT, only if it names an active
         task, it is the only active task, AND no session has claimed anything (a
         checkout where sessions are being tracked is not a no-session host).
      4. anything else -> None: ambiguity means fail open, never a guess."""
    active = active_task_ids()
    if sid:
        mapped = read_session_map(sid)
        if mapped:
            if mapped in active:
                return mapped, "mapped"
            remove_session_map(sid)
        return None, ("no active task" if not active else
                      f"no mapping for session {sid} ({len(active)} active task(s)); bind "
                      f"explicitly — an unmapped session never adopts a task")
    if all_session_maps():
        return None, "no session id, but sessions are tracked in this checkout"
    current = read_current()
    if current and current in active and len(active) == 1:
        return current, "current-single-active"
    return None, ("no active task" if not active else
                  "ambiguous: no session id and more than one active task")

def scan_runs_jsonl_for_task(task_id):
    """Read runs.jsonl once and split, for this task, cleanly-parsed episode lines from
    malformed ones that still reference the task. A malformed line is best-effort
    attributed to the task the same way the other regex-based audit checks work: the
    raw text still carries a `"task": "<id>"` field even though it fails to parse as
    JSON (fix B — audit check (j) needs both halves). Returns (parsed, malformed) where
    malformed is a list of (lineno, raw_line)."""
    p = runs_path()
    parsed = []
    malformed = []
    if not os.path.isfile(p):
        return parsed, malformed
    task_marker = re.compile(r'"task"\s*:\s*"' + re.escape(task_id) + r'"')
    with open(p, encoding="utf-8") as f:
        for lineno, raw in enumerate(f, start=1):
            raw = raw.strip()
            if not raw:
                continue
            try:
                obj = json.loads(raw)
            except json.JSONDecodeError:
                if task_marker.search(raw):
                    malformed.append((lineno, raw))
                continue
            if obj.get("task") == task_id:
                parsed.append(obj)
    return parsed, malformed

def read_episode_lines_for_task(task_id):
    parsed, _ = scan_runs_jsonl_for_task(task_id)
    return parsed

# ---------- locking ----------
# Per-task lock: .eaos/<id>/.lock — guards state.json + warroom.md for that task.
# Project lock: .eaos/.lock — guards config.json, runs.jsonl, and any cross-task scan
# (parent-tree spawn budget, duplicate fingerprint lookup). When both are needed the
# project lock is always acquired first, so lock order is consistent everywhere and
# concurrent callers can never deadlock against each other.

def _record_lock_steal(path, age, task_id):
    """A stale-lock steal means a previous eaos process died mid-mutation (or a real bug):
    the state it was writing may be inconsistent. Record it project-wide and in the task's
    war room so audit (m) can surface it until a human acknowledges it (round 5 item 6)."""
    ev = {"at": now_iso(), "path": path, "age_seconds": round(age), "by_pid": os.getpid(),
          "task": task_id}
    try:
        os.makedirs(eaos_dir(), exist_ok=True)
        fd = os.open(lock_events_path(), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        try:
            os.write(fd, (json.dumps(ev) + "\n").encode("utf-8"))
        finally:
            os.close(fd)
        if task_id and os.path.isfile(warroom_path(task_id)):
            # NB: this line must never contain the ack token itself (audit (m) scans the
            # war room for it) — a steal record that acknowledged itself would be useless.
            warroom_log(task_id, f"[{ev['at']}] LOCK STOLEN path={path} age={ev['age_seconds']}s "
                                 f"— a prior process died mid-mutation; review state, then "
                                 f"acknowledge with a STATUS message (token: docs/HOOKS.md)")
    except OSError:
        pass

def _acquire_lock(path, task_id=None):
    deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
    while True:
        try:
            fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            try:
                os.write(fd, str(os.getpid()).encode("utf-8"))
            finally:
                os.close(fd)
            return
        except FileExistsError:
            pass
        try:
            age = time.time() - os.path.getmtime(path)
        except OSError:
            continue  # lock vanished between the open() and stat() — just retry
        if age > LOCK_STALE_SECONDS:
            print(f"WARN: stale lock {path} (age {age:.0f}s) — stealing", file=sys.stderr)
            try:
                os.remove(path)
            except OSError:
                pass
            _record_lock_steal(path, age, task_id)
            continue
        if time.monotonic() >= deadline:
            die(f"lock busy: {path} — another eaos process is mutating this state, "
                f"retry shortly", EXIT_INFRA)
        time.sleep(LOCK_POLL_SECONDS)

def _release_lock(path):
    try:
        os.remove(path)
    except OSError:
        pass

@contextlib.contextmanager
def task_lock(task_id):
    p = os.path.join(task_dir(task_id), ".lock")
    _acquire_lock(p, task_id)
    try:
        yield
    finally:
        _release_lock(p)

# ---------- hard-blocker gate (fix 1 / spec §6) ----------
# A hard_blocker loopback transitions the task to status="blocked" (see cmd_loopback).
# Every mutating verb except status/audit/report/episode close/loopback must refuse to
# run against a blocked task — only a human, via `phase ... --unblock`, can resume it.

def ensure_not_blocked(state, task_id):
    blocked = state.get("blocked") or {}
    reason = blocked.get("reason", "unknown")
    die(f"task is BLOCKED ({reason}) — resolve via human gate; use "
        f"`eaos phase {task_id} <PHASE> --unblock --reason '<r>'` to resume", 1)

@contextlib.contextmanager
def project_lock():
    os.makedirs(eaos_dir(), exist_ok=True)
    p = os.path.join(eaos_dir(), ".lock")
    _acquire_lock(p)
    try:
        yield
    finally:
        _release_lock(p)

# ---------- idempotency ----------
# Only successful (exit-0) mutations are cached: a rejected/ceiling-hit call never
# touched state, so replaying it with the same args is already naturally idempotent —
# no key bookkeeping needed for the failure paths.
#
# Idempotency map (spec §11 — every mutating verb accepts or generates an idempotency
# key; BY-CONSTRUCTION means a replay is already safe without a key because the
# operation is a deterministic overwrite/no-op, not because it silently double-mutates).
# KEYED verbs (fix A) bind the key to a sha256 request fingerprint over the verb, task
# id, normalized args, and any stdin/body content (see compute_request_fingerprint) —
# the same key reused for a materially different request is refused as an IDEMPOTENCY
# CONFLICT (exit 1, nothing mutated) rather than replayed or silently re-mutated under
# the first call's cached slot:
#   init            BY-CONSTRUCTION — no-ops when config.json already exists
#   task new        KEYED (--idempotency-key; project-level store .eaos/idempotency.json,
#                   fix C) AND fingerprint-guarded (exact match blocks, overlap warns) —
#                   the two are independent: the idempotency key detects "this exact call
#                   was retried," the duplicate fingerprint detects "this is the same
#                   task request even without a shared key"
#   append          KEYED (--idempotency-key)
#   phase           KEYED (--idempotency-key)
#   spawn           KEYED (--idempotency-key)
#   loopback        KEYED (--idempotency-key)
#   gate            KEYED (--idempotency-key)
#   verify          KEYED (--idempotency-key; single-criterion and --bulk both)
#   episode close   KEYED (--idempotency-key) + --amend for a genuine, intentional
#                   re-close; also refuses (independent of any key) a duplicate
#                   (task, close_revision) pair already on disk (fix B)
#   report          BY-CONSTRUCTION — deterministic overwrite of the same artifact path
#                   from the same state; task-locked while writing, no key needed
#   status / audit  read-only, not mutating — no idempotency concern

def idempotency_lookup(state, key):
    if not key:
        return None
    for entry in state.get("idempotency_keys", []):
        if entry.get("key") == key:
            return entry
    return None

def idempotency_record(state, key, fingerprint, output):
    if not key:
        return
    keys = state.setdefault("idempotency_keys", [])
    keys.append({"key": key, "fingerprint": fingerprint, "output": output})
    if len(keys) > IDEMPOTENCY_KEEP:
        del keys[: len(keys) - IDEMPOTENCY_KEEP]

def compute_request_fingerprint(verb, task_id, arg_pairs=(), body_text=None):
    """Deterministic hash of an idempotency-keyed request (fix A / spec §11): sha256
    over (verb, task id, sorted normalized argument pairs excluding the key itself,
    sha256 of any stdin/body content). Two calls presenting the same key but a
    different fingerprint mean the key was reused for a materially different request —
    that must be refused (IDEMPOTENCY CONFLICT), never silently replayed and never
    silently re-mutated under the first call's cached output."""
    normalized = sorted((str(k), "" if v is None else str(v)) for k, v in arg_pairs)
    body_hash = hashlib.sha256((body_text or "").encode("utf-8")).hexdigest()
    payload = json.dumps(
        {"verb": verb, "task": task_id or "", "args": normalized, "body_sha256": body_hash},
        sort_keys=True,
    )
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()

def idempotency_guard(state, key, fingerprint, verb, task_id):
    """Look up `key` in state.idempotency_keys (a no-op if key is falsy). Found +
    fingerprint matches -> print the cached output and exit 0 (safe replay). Found +
    fingerprint differs -> exit 1 as an IDEMPOTENCY CONFLICT; nothing is mutated because
    this check runs before any state change. Not found -> return normally so the caller
    proceeds to mutate and must call idempotency_record() with this same fingerprint."""
    entry = idempotency_lookup(state, key)
    if not entry:
        return
    if entry.get("fingerprint") != fingerprint:
        print(f"IDEMPOTENCY CONFLICT: key '{key}' was used for a different request "
              f"({verb} {task_id}) — use a new key")
        sys.exit(1)
    print(entry["output"])
    sys.exit(0)

# ---------- task-new idempotency store (fix C) ----------
# Project-level, not per-task: task new hasn't allocated a task id yet when the key is
# checked, so the map (key -> {task_id, fingerprint, at}) lives in its own file guarded
# by the project lock, mirroring config.json/runs.jsonl.

def task_idempotency_path():
    return os.path.join(eaos_dir(), "idempotency.json")

def load_task_idempotency():
    p = task_idempotency_path()
    if not os.path.isfile(p):
        return {}  # tolerated: created lazily on first use, same as init would create it
    with open(p, encoding="utf-8") as f:
        try:
            return json.load(f)
        except json.JSONDecodeError:
            return {}

def save_task_idempotency(store):
    if len(store) > IDEMPOTENCY_KEEP:
        for k in list(store.keys())[: len(store) - IDEMPOTENCY_KEEP]:
            del store[k]
    p = task_idempotency_path()
    tmp = f"{p}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(store, f, indent=2)
        f.write("\n")
    os.replace(tmp, p)

def compute_task_new_fingerprint(title, kind, stakes, playbook, parent, paths,
                                  criteria_ids, outcome, session=None):
    """Fingerprint for the task-new idempotency key (fix C) — distinct from
    compute_fingerprint (the duplicate-detection fingerprint below): this one folds in
    every field the CLI call actually carries (including stakes/playbook, which don't
    matter for duplicate detection) because its only job is "was this the exact same
    create-task call replayed, or a different one reusing the same key." It needs no
    structured-intake machinery to do that — see the compute_fingerprint docstring for
    why semantic duplicate detection is a harder, separate problem."""
    payload = json.dumps({
        "title": (title or "").strip(),
        "kind": kind or "",
        "stakes": stakes or "",
        "playbook": playbook or "",
        "parent": parent or "",
        "paths": sorted(p.strip() for p in (paths or []) if p.strip()),
        "criteria": sorted(c.strip() for c in (criteria_ids or []) if c.strip()),
        "outcome": (outcome or "").strip(),
        "session": session or "",   # round 5 item 4: same key from another session = conflict
    }, sort_keys=True)
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()

# ---------- init ----------

def cmd_init(args):
    d = eaos_dir()
    for sub in ("decisions", "patterns", "lessons", "codebase"):
        os.makedirs(os.path.join(d, "memory", sub), exist_ok=True)

    index_path = os.path.join(d, "memory", "index.md")
    seeded = "skipped"
    if not os.path.isfile(index_path):
        seed = os.path.expanduser("~/.claude/eaos/memory-seed/index.md")
        if os.path.isfile(seed):
            with open(seed, encoding="utf-8") as f:
                content = f.read()
            with open(index_path, "w", encoding="utf-8") as f:
                f.write(content)
            seeded = "seeded"
        else:
            seeded = "no-seed-available"

    cfg_status = "existing"
    with project_lock():
        if not os.path.isfile(config_path()):
            cfg = dict(DEFAULT_CONFIG)
            if args.max_spawns is not None:
                cfg["max_agent_spawns_per_task"] = args.max_spawns
            if args.max_same_issue is not None:
                cfg["max_same_issue_loops"] = args.max_same_issue
            if args.max_total_loopbacks is not None:
                cfg["max_total_loopbacks"] = args.max_total_loopbacks
            if args.reserve_verifier is not None:
                cfg["reserved_verifier_spawns"] = args.reserve_verifier
            if args.reserve_loopbacks is not None:
                cfg["reserved_loopback_spawns"] = args.reserve_loopbacks
            with open(config_path(), "w", encoding="utf-8") as f:
                json.dump(cfg, f, indent=2)
                f.write("\n")
            cfg_status = "created"
        if not os.path.isfile(task_idempotency_path()):
            save_task_idempotency({})

    print(f"OK: eaos initialized (config: {cfg_status}, memory-index: {seeded})")
    sys.exit(0)

# ---------- task new ----------

def allocate_task_id():
    d = eaos_dir()
    os.makedirs(d, exist_ok=True)
    while True:
        existing = [n for n in os.listdir(d) if re.match(r"^T-\d+$", n)]
        nums = [int(n.split("-")[1]) for n in existing] or [0]
        candidate = f"T-{max(nums) + 1:03d}"
        path = os.path.join(d, candidate)
        try:
            os.makedirs(path)  # exclusive create — races lose here and retry
            return candidate, path
        except FileExistsError:
            continue

def all_task_ids():
    d = eaos_dir()
    if not os.path.isdir(d):
        return []
    return sorted(n for n in os.listdir(d) if re.match(r"^T-\d+$", n))

def _tokenize(text):
    return sorted(re.findall(r"\w+", (text or "").lower()))

def compute_fingerprint(parent, kind, title, paths=None, criteria=None, outcome=None):
    """Deterministic duplicate fingerprint (spec §11: {parent, kind, target paths/
    symbols, criteria ids, outcome}). Honest limitation: this catches only WORDING
    overlap (same tokens/paths/criteria) — a semantic duplicate phrased differently
    ("fix the flaky login test" vs "stabilize sign-in spec") is invisible to it. That
    needs structured intake fields captured upstream of task creation, which does not
    exist yet (fix 4 note). Task new's own idempotency key (fix C, see
    compute_task_new_fingerprint) is a separate, exact-replay mechanism and does not
    need that machinery — it only detects an identical retried call, not a semantic
    duplicate."""
    title_tokens = _tokenize(title)
    path_list = sorted(p.strip() for p in (paths or []) if p.strip())
    criteria_list = sorted(c.strip() for c in (criteria or []) if c.strip())
    outcome_tokens = _tokenize(outcome)
    normalized = "|".join([
        parent or "",
        kind or "",
        " ".join(title_tokens),
        " ".join(path_list),
        " ".join(criteria_list),
        " ".join(outcome_tokens),
    ])
    return hashlib.sha256(normalized.encode("utf-8")).hexdigest()

def find_duplicate_task(fingerprint):
    for tid in all_task_ids():
        try:
            st = load_state(tid)
        except SystemExit:
            continue
        if st.get("fingerprint") == fingerprint and st.get("status") != "closed":
            return tid
    return None

def overlap_token_set(title, paths, criteria):
    tokens = set(_tokenize(title))
    tokens |= set(p.strip() for p in (paths or []) if p.strip())
    tokens |= set(c.strip() for c in (criteria or []) if c.strip())
    return tokens

def jaccard(a, b):
    union = a | b
    if not union:
        return 0.0
    return len(a & b) / len(union)

def find_overlap_warnings(parent, title, paths, criteria):
    """Best-effort duplicate signal (fix 4): token-set Jaccard on title ∪ paths ∪
    criteria against every non-closed task under the same parent (or, if parent is
    None, every non-closed top-level task). Advisory only — never blocks."""
    new_tokens = overlap_token_set(title, paths, criteria)
    warnings = []
    for tid in all_task_ids():
        try:
            st = load_state(tid)
        except SystemExit:
            continue
        if st.get("status") == "closed" or st.get("parent") != parent:
            continue
        other_tokens = overlap_token_set(st.get("title", ""), st.get("paths", []),
                                          st.get("criteria_ids", []))
        score = jaccard(new_tokens, other_tokens)
        if score >= 0.5:
            warnings.append((tid, score))
    return sorted(warnings)

def cmd_task_new(args):
    if args.parent:
        task_dir(args.parent)  # validates existence; dies with usage error if missing
    session = args.session or os.environ.get("EAOS_SESSION_ID") or None
    if session:
        check_session_id(session)
    if args.allow_duplicate and not args.reason:
        die("task new: --allow-duplicate requires --reason", 2)

    paths = [p.strip() for p in (args.paths or "").split(",") if p.strip()]
    criteria_ids = [c.strip() for c in (args.criteria or "").split(",") if c.strip()]
    outcome = args.outcome

    fp = compute_fingerprint(args.parent, args.kind, args.title, paths, criteria_ids,
                              outcome)
    key_fp = compute_task_new_fingerprint(args.title, args.kind, args.stakes,
                                           args.playbook, args.parent, paths,
                                           criteria_ids, outcome, session)

    with project_lock():
        # fix C: task-new idempotency key, checked before anything else — a replay
        # creates nothing and just prints the original id; a conflict refuses outright.
        idempotency_store = None
        if args.idempotency_key:
            idempotency_store = load_task_idempotency()
            entry = idempotency_store.get(args.idempotency_key)
            if entry:
                if entry.get("fingerprint") != key_fp:
                    print(f"IDEMPOTENCY CONFLICT: key '{args.idempotency_key}' was used "
                          f"for a different request (task new '{args.title}') — use a "
                          f"new key")
                    sys.exit(1)
                # Replay (caller lost the first response): re-establish the session
                # binding too, so the retry is idempotent for the mapping as well.
                if session and entry["task_id"] in active_task_ids():
                    write_session_map(session, entry["task_id"])
                print(entry["task_id"])
                sys.exit(0)

        if not args.allow_duplicate:
            dup = find_duplicate_task(fp)
            if dup:
                die(f"DUPLICATE: fingerprint matches {dup} — resume it instead (or pass "
                    f"--allow-duplicate --reason '<why>')", 1)

        # Overlap warning (fix 4): advisory only, never blocks — see find_overlap_warnings
        # for the honest limitation (wording overlap only, no semantic matching).
        warnings = find_overlap_warnings(args.parent, args.title, paths, criteria_ids)

        task_id, path = allocate_task_id()
        os.makedirs(os.path.join(path, "artifacts"), exist_ok=True)
        ts = now_iso()
        with open(os.path.join(path, "warroom.md"), "w", encoding="utf-8") as f:
            f.write(f"# {task_id}: {args.title}\n\nCreated: {ts}\nStatus: active\n\n"
                    f"## War Room Log\n")
        state = {
            "id": task_id,
            "title": args.title,
            "kind": args.kind,
            "stakes": args.stakes,
            "playbook": args.playbook,
            "parent": args.parent,
            "paths": paths,
            "criteria_ids": criteria_ids,
            "outcome": outcome,
            "fingerprint": fp,
            "created": ts,
            "status": "active",
            "blocked": None,
            "unblocks": [],
            "phase": "INTAKE",
            "phase_history": [{"phase": "INTAKE", "at": ts}],
            "next_msg_num": 1,
            "messages": [],
            "spawns": {"count": 0, "log": []},
            "loopbacks": {"total": 0, "by_issue": {}, "ledger": []},
            "gates": {},
            "criteria": {},
            "overlap_warnings": [],
            "idempotency_keys": [],
        }
        for tid, score in warnings:
            print(f"WARN: overlaps {tid} (jaccard {score:.2f}) — possible duplicate; "
                  f"resume it or continue")
            state["overlap_warnings"].append({"task": tid, "jaccard": round(score, 2)})
        if args.allow_duplicate and args.reason:
            state["duplicate_override_reason"] = args.reason
        save_state(task_id, state)
        write_current(task_id)  # M-007: legacy global pointer (single-session fallback)
        if session:
            write_session_map(session, task_id)  # M-007: session-scoped pointer (HIGH-4)

        if args.idempotency_key:
            idempotency_store[args.idempotency_key] = {
                "task_id": task_id, "fingerprint": key_fp, "at": ts,
            }
            save_task_idempotency(idempotency_store)
    print(task_id)
    sys.exit(0)

# ---------- append ----------

def cmd_append(args):
    if (args.body is None) == (args.file is None):
        die("append: need exactly one of --body or --file", 2)
    if args.file is not None:
        if args.file == "-":
            body_text = sys.stdin.read()
        else:
            with open(args.file, encoding="utf-8") as f:
                body_text = f.read()
    else:
        body_text = args.body
    body_text = body_text.rstrip("\n")

    # A RISK must be classifiable, or the registry that `verify --require` trusts is
    # incomplete by construction (v4 review 2, finding 1: `--priority blocking` with body
    # "severity: high" was never registered, because registration keyed on priority ==
    # "high" — a value protocol.md does not even define; its priority enum is
    # blocking|normal|fyi and severity lives with the risk). Resolution order: --severity,
    # then `severity: X` in the body, then a legacy priority of low/med/high. A priority
    # of `blocking` always registers. No severity at all is a usage error, not a silent
    # unregistered risk.
    risk_severity = None
    if args.type == "RISK":
        risk_severity = resolve_risk_severity(args.severity, args.priority, body_text)
        if risk_severity is None:
            die("append: a RISK needs a severity — pass --severity low|medium|high|blocking "
                "(or state `severity: <level>` in the body). An unclassified risk cannot be "
                "registered, and an unregistered risk cannot block a false completion", 2)

    with task_lock(args.id):
        state = load_state(args.id)
        fp_fields = [("from", args.frm), ("to", args.to), ("type", args.type),
                     ("ref", args.ref), ("priority", args.priority)]
        if args.type == "RISK":
            # The RESOLVED severity decides whether this risk blocks completion, so it is
            # part of the request: the same key with a different severity is a conflict,
            # not a replay (review 3, finding 1). Added for RISK only, so keys recorded
            # for other message types before this change still replay.
            fp_fields.append(("severity", risk_severity))
        fp = compute_request_fingerprint("append", args.id, fp_fields, body_text=body_text)
        idempotency_guard(state, args.idempotency_key, fp, "append", args.id)
        if state.get("status") == "blocked":
            ensure_not_blocked(state, args.id)

        to_list = [t.strip() for t in args.to.split(",") if t.strip()]
        msg_id = f"msg-{state['next_msg_num']:03d}"
        ts = now_iso()
        msg = {
            "id": msg_id, "from": args.frm, "to": to_list, "type": args.type,
            "ref": args.ref, "priority": args.priority, "body": body_text, "at": ts,
        }
        if risk_severity:
            msg["severity"] = risk_severity
        state["messages"].append(msg)
        state["next_msg_num"] += 1
        # Risk-to-test law (real run 2026-09-09: R-OBS-A, a high RISK the SRE agent
        # raised, was filed as "follow-up", survived a launch-review GO, and was proven a
        # crash-loop only when the human asked for a rehearsal). A high-priority RISK opens
        # a criterion slot `R-<msg-id>`; `verify --require` and `report` refuse until it
        # carries a verdict — verified/failed after a test, or an honest blocked/
        # manual_confirmation_required. "Follow-up" is not a verdict.
        if args.type == "RISK" and risk_severity in RISK_REGISTERED_SEVERITIES:
            state.setdefault("open_risks", []).append({"msg": msg_id, "at": ts,
                                                       "seq": next_seq(state),
                                                       "from": args.frm,
                                                       "severity": risk_severity})

        out = f"OK: {msg_id} appended ({args.type} {args.frm} -> {', '.join(to_list)})"
        idempotency_record(state, args.idempotency_key, fp, out)
        save_state(args.id, state)

        block = [f"\n- id: {msg_id}", f"  from: {args.frm}", f"  to: [{', '.join(to_list)}]",
                  f"  type: {args.type}"]
        if args.ref:
            block.append(f"  ref: {args.ref}")
        block.append(f"  priority: {args.priority}")
        block.append("  body: >")
        for line in body_text.splitlines() or [""]:
            block.append(f"    {line}")
        warroom_log(args.id, "\n".join(block) + "\n")

    print(out)
    sys.exit(0)

# ---------- phase ----------

def cmd_phase(args):
    with task_lock(args.id):
        state = load_state(args.id)
        fp = compute_request_fingerprint(
            "phase", args.id,
            [("phase", args.phase), ("unblock", args.unblock), ("reason", args.reason)],
        )
        idempotency_guard(state, args.idempotency_key, fp, "phase", args.id)
        if state.get("status") == "blocked" and not args.unblock:
            ensure_not_blocked(state, args.id)

        ts = now_iso()
        unblock_note = ""
        if args.unblock:
            if not args.reason:
                die("phase --unblock requires --reason", 2)
            entry = {"reason": args.reason, "at": ts, "cleared": state.get("blocked")}
            state.setdefault("unblocks", []).append(entry)
            state["status"] = "active"
            state["blocked"] = None
            unblock_note = f" UNBLOCKED reason={args.reason}"

        old = state.get("phase")
        state["phase"] = args.phase
        state["phase_history"].append({"phase": args.phase, "at": ts})
        out = f"OK: phase {old} -> {args.phase}" + (" (unblocked)" if args.unblock else "")
        idempotency_record(state, args.idempotency_key, fp, out)
        save_state(args.id, state)
        warroom_log(args.id, f"\n[{ts}] STATUS phase: {old} -> {args.phase}{unblock_note}\n")
    print(out)
    sys.exit(0)

# ---------- spawn ----------

def find_root(task_id, seen=None):
    seen = seen if seen is not None else set()
    if task_id in seen:
        return task_id  # cycle guard — should never happen, but never loop forever
    seen.add(task_id)
    parent = load_state(task_id).get("parent")
    if not parent:
        return task_id
    return find_root(parent, seen)

def tree_task_ids(root_id):
    ids = all_task_ids()
    parent_map = {}
    for tid in ids:
        try:
            parent_map[tid] = load_state(tid).get("parent")
        except SystemExit:
            continue
    tree = set()
    def add(tid):
        if tid in tree:
            return
        tree.add(tid)
        for child, par in parent_map.items():
            if par == tid:
                add(child)
    add(root_id)
    return tree

def tree_spawn_total(task_id):
    """Sum spawns.count across the whole ancestry tree (root + all descendants). Caller
    must already hold the project lock so this scan-then-decide is atomic."""
    root = find_root(task_id)
    tree = tree_task_ids(root)
    total = sum(load_state(tid).get("spawns", {}).get("count", 0) for tid in tree)
    return total, root

# ---------- audit check (k) helpers: parent-tree topology ----------
# Unlike find_root/tree_task_ids above (which assume a healthy tree and will die() via
# load_state on a dangling parent reference), audit must survive and report exactly that
# kind of corruption, so it gets its own in-memory-only, non-dying versions built from a
# single upfront snapshot of every task's {parent, spawns.count}.

def audit_task_snapshot():
    """One-pass scan of every .eaos/T-*/state.json for its parent + spawns.count. A task
    whose state.json fails to load is simply absent from the map (not counted as
    dangling) — the same best-effort tolerance tree_task_ids already applies."""
    snap = {}
    for tid in all_task_ids():
        try:
            st = load_state(tid)
        except SystemExit:
            continue
        snap[tid] = {"parent": st.get("parent"),
                     "spawns": st.get("spawns", {}).get("count", 0)}
    return snap

def audit_locate_root(task_id, snap):
    """Walk parent pointers in-memory (no disk I/O, never dies). Stops — and reports
    that node as the effective root for tree-traversal purposes — at whichever comes
    first: no parent (a true root), a parent missing from `snap` (dangling reference),
    or a repeated node (cycle). The dangling/cycle conditions themselves are detected
    and reported separately; this just guarantees audit always terminates."""
    seen = []
    cur = task_id
    while True:
        if cur in seen:
            return cur
        seen.append(cur)
        parent = snap.get(cur, {}).get("parent")
        if not parent or parent not in snap:
            return cur
        cur = parent

def audit_tree_members(root_id, snap):
    """Descendant set of root_id via child pointers (mirrors tree_task_ids), operating
    purely on the snapshot so it tolerates dangling/cyclic data without recursing into
    load_state."""
    tree = set()
    def add(tid):
        if tid in tree:
            return
        tree.add(tid)
        for child, info in snap.items():
            if info.get("parent") == tid:
                add(child)
    add(root_id)
    return tree

def audit_find_cycle(task_id, snap):
    """Walk the parent chain from task_id. Returns the sorted list of task ids forming a
    cycle if the chain revisits a node before hitting a true root or a dangling parent;
    otherwise None."""
    chain = []
    cur = task_id
    while cur is not None:
        if cur in chain:
            return sorted(chain[chain.index(cur):])
        chain.append(cur)
        parent = snap.get(cur, {}).get("parent")
        if parent is not None and parent not in snap:
            return None  # dangling — a different discrepancy, not a cycle
        cur = parent
    return None

def cmd_spawn(args):
    cfg = load_config()
    cap = cfg["max_agent_spawns_per_task"]
    with project_lock():
        with task_lock(args.id):
            state = load_state(args.id)
            fp = compute_request_fingerprint("spawn", args.id, [("agent", args.agent)])
            idempotency_guard(state, args.idempotency_key, fp, "spawn", args.id)
            if state.get("status") == "blocked":
                ensure_not_blocked(state, args.id)

            # Check BEFORE persisting: a rejected spawn never happened, so it must not
            # consume a slot — otherwise one rejection would lock the budget out
            # permanently.
            total, root = tree_spawn_total(args.id)
            ts = now_iso()
            if total + 1 > cap:
                warroom_log(args.id, f"[{ts}] SPAWN REJECTED agent={args.agent} "
                                      f"tree_total={total}/{cap} root={root} (over budget)")
                print(f"BUDGET EXCEEDED: tree total would be {total + 1}/{cap} spawns "
                      f"(root {root}) — downgrade or drop an agent, or raise the cap "
                      f"consciously at init")
                sys.exit(1)
            is_verifier = bool(VERIFIER_AGENT_RE.search(args.agent))
            reserve_lb = int(cfg.get("reserved_loopback_spawns", 0) or 0)
            reserve_v = int(cfg.get("reserved_verifier_spawns", 0) or 0)
            planning_cap = cap - reserve_v - reserve_lb
            if (reserve_lb and total + 1 > planning_cap and not is_verifier
                    and state.get("loopbacks", {}).get("total", 0) == 0):
                warroom_log(args.id, f"[{ts}] SPAWN REJECTED agent={args.agent} "
                                      f"tree_total={total}/{cap} root={root} "
                                      f"(planning cap {planning_cap}; {reserve_lb} slot(s) open "
                                      f"only after a loop-back)")
                print(f"BUDGET EXCEEDED: planning cap is {planning_cap} of {cap} — the next "
                      f"{reserve_lb} slot(s) are RESERVED for loop-back work and open only once "
                      f"`eaos loopback` has recorded one (tree total {total}/{cap}, root {root}). "
                      f"Trim the roster or raise the cap consciously at init; never fold an "
                      f"independent role into yourself to fit")
                sys.exit(1)
            reserve = reserve_v
            if reserve and total + 1 > cap - reserve and not is_verifier:
                warroom_log(args.id, f"[{ts}] SPAWN REJECTED agent={args.agent} "
                                      f"tree_total={total}/{cap} root={root} "
                                      f"(last {reserve} slot(s) reserved for a verifier)")
                print(f"BUDGET EXCEEDED: the last {reserve} of {cap} spawns are RESERVED for "
                      f"a verifier re-grade (tree total {total}/{cap}, root {root}) — a "
                      f"fresh checker must grade the fix; the orchestrator never grades "
                      f"its own work")
                sys.exit(1)

            state["spawns"]["count"] += 1
            n = state["spawns"]["count"]
            state["spawns"]["log"].append({"agent": args.agent, "at": ts})
            out = f"OK: {n}/{cap} spawns (tree total {total + 1}/{cap}, root {root})"
            idempotency_record(state, args.idempotency_key, fp, out)
            save_state(args.id, state)
            warroom_log(args.id, f"[{ts}] SPAWN agent={args.agent} tally={n}/{cap} "
                                  f"tree_total={total + 1}/{cap}")
    print(out)
    sys.exit(0)

# ---------- loopback ----------

def print_ledger(entries):
    for e in entries:
        print(f"  - [{e['at']}] edge={e['edge']} issue={e['issue']}: {e['attempt']}")

def cmd_loopback(args):
    cfg = load_config()
    max_same = cfg["max_same_issue_loops"]
    max_total = cfg["max_total_loopbacks"]
    lb_class = args.klass or "recoverable"

    with task_lock(args.id):
        state = load_state(args.id)
        fp = compute_request_fingerprint(
            "loopback", args.id,
            [("edge", args.edge), ("issue", args.issue), ("attempt", args.attempt),
             ("class", lb_class)],
        )
        idempotency_guard(state, args.idempotency_key, fp, "loopback", args.id)

        lb = state["loopbacks"]

        if lb_class == "recoverable":
            prior = [e for e in lb["ledger"] if e["issue"] == args.issue]
            if prior and prior[-1]["attempt"] == args.attempt:
                # Rejected before touching counters — same reasoning as spawn's
                # check-before-persist: a rejected retry never happened.
                print(f"REJECTED: retry must vary — attempt text identical to the "
                      f"previous attempt for issue '{args.issue}'")
                sys.exit(1)

        ts = now_iso()
        lb["total"] += 1
        lb["by_issue"][args.issue] = lb["by_issue"].get(args.issue, 0) + 1
        entry = {"edge": args.edge, "issue": args.issue, "attempt": args.attempt,
                  "class": lb_class, "at": ts}
        lb["ledger"].append(entry)

        same_n = lb["by_issue"][args.issue]
        total_n = lb["total"]

        if lb_class == "hard_blocker":
            # Spec §6 retry law: hard_blocker never loops — it transitions the task to
            # BLOCKED (a human gate), not just a printed warning (fix 1).
            state["status"] = "blocked"
            state["blocked"] = {"reason": args.attempt, "issue": args.issue, "at": ts}
            save_state(args.id, state)
            warroom_log(args.id, f"[{ts}] LOOPBACK edge={args.edge} issue={args.issue} "
                                  f"class=hard_blocker attempt={args.attempt} "
                                  f"BLOCKED — escalate to human")
            print("BLOCKED — escalate to human")
            print_ledger([e for e in lb["ledger"] if e["issue"] == args.issue])
            sys.exit(1)

        warroom_log(args.id, f"[{ts}] LOOPBACK edge={args.edge} issue={args.issue} "
                              f"class={lb_class} attempt={args.attempt} "
                              f"(same-issue {same_n}/{max_same}, total {total_n}/{max_total})")

        if same_n > max_same:
            save_state(args.id, state)
            print(f"DEADLOCK: issue '{args.issue}' looped {same_n} times — escalate to the "
                  f"human with the attempt ledger")
            print_ledger([e for e in lb["ledger"] if e["issue"] == args.issue])
            sys.exit(1)

        if total_n > max_total:
            save_state(args.id, state)
            print(f"CEILING: {total_n} total loop-backs — halt, hand the human the attempt "
                  f"ledger + best current state")
            print_ledger(lb["ledger"])
            sys.exit(1)

        out = (f"OK: {same_n}/{max_same} same-issue, {total_n}/{max_total} total loop-backs "
               f"remaining allowance {max_same - same_n}/{max_total - total_n}")
        idempotency_record(state, args.idempotency_key, fp, out)
        save_state(args.id, state)

    print(out)
    sys.exit(0)

# ---------- gate ----------

def cmd_gate(args):
    if args.require:
        state = load_state(args.id)
        phase_gates = state.get("gates", {}).get(args.phase, {})
        if not phase_gates:
            print(f"GATE UNMET: {args.phase} — no checks recorded for this phase")
            sys.exit(1)
        failed = [name for name, r in phase_gates.items() if r["result"] != "pass"]
        if failed:
            print(f"GATE UNMET: {args.phase} — failed checks: {', '.join(failed)}")
            sys.exit(1)
        print(f"OK: {args.phase} gate satisfied ({len(phase_gates)} checks pass)")
        sys.exit(0)

    if not args.check or (args.passed == args.failed):  # neither or both given
        die("gate: need --check NAME with exactly one of --pass/--fail, or --require", 2)

    result = "pass" if args.passed else "fail"
    with task_lock(args.id):
        state = load_state(args.id)
        fp = compute_request_fingerprint(
            "gate", args.id,
            [("phase", args.phase), ("check", args.check), ("result", result),
             ("note", args.note)],
        )
        idempotency_guard(state, args.idempotency_key, fp, "gate", args.id)
        if state.get("status") == "blocked":
            ensure_not_blocked(state, args.id)

        gates = state.setdefault("gates", {})
        phase_gates = gates.setdefault(args.phase, {})
        ts = now_iso()
        phase_gates[args.check] = {"result": result, "note": args.note, "at": ts}
        out = f"OK: {args.phase}/{args.check} = {result}"
        idempotency_record(state, args.idempotency_key, fp, out)
        save_state(args.id, state)
        warroom_log(args.id, f"[{ts}] GATE phase={args.phase} check={args.check} "
                              f"result={result} note={args.note or ''}")
    print(out)
    sys.exit(0)

# ---------- verify ----------

def require_status(state):
    """Returns (ok, reason, manual_confirmation_keys, unresolved_keys).
    ok=False means verify --require must exit 1 (a failed criterion, or none recorded).
    ok=True with either list non-empty means CONDITIONAL (exit 3): manual_confirmation_
    keys are criteria whose implementation may be complete but await human confirmation;
    unresolved_keys (blocked/not_reproducible) mean the implementation itself is NOT
    claimed complete for that criterion (fix 2 — honest conditional semantics)."""
    criteria = state.get("criteria", {})
    if not criteria:
        return False, "zero criteria recorded", [], []
    failed = [k for k, v in criteria.items() if v["verdict"] == "failed"]
    if failed:
        return False, f"failed criteria: {', '.join(failed)}", [], []
    # A verdict only answers a risk if it was recorded AFTER the risk existed. Message ids
    # are predictable, so without this a pre-dated `R-msg-007` could pre-clear a risk that
    # had not been raised yet. Ordering uses the persisted revision sequence, never the
    # wall clock: `at` has one-second resolution, so `>=` admitted a verdict recorded
    # BEFORE its risk within the same second, and `>` would reject a legitimate one
    # recorded just after it (review 4, finding 1). Legacy records: a risk with no `seq`
    # predates ordering metadata and is treated as sequence 0; a VERDICT with no `seq`
    # cannot be ordered and must be re-recorded. This is an ordering guard, not proof that
    # the verdict's evidence addresses the risk — that remains uncertified (v4 spec R-7).
    def answered(r):
        v = criteria.get(f"R-{r['msg']}")
        if not v or not isinstance(v.get("seq"), int):
            return False
        return v["seq"] > int(r.get("seq", 0) or 0)
    ungraded = [sid for sid in state.get("scenarios", []) if sid not in criteria]
    if ungraded:
        return (False, "scenario(s) without a verdict: " + ", ".join(ungraded) +
                " — the checker grades each by execution (`eaos scenario grade`)", [], [])
    open_risks = [r["msg"] for r in state.get("open_risks", []) if not answered(r)]
    # v4 review 1, finding 3: the new runtime state must reach the completion authority.
    units = state.get("units", {}) or {}
    unfinished = [f"{u['id']} is {u['status'].upper()}"
                  + (f" ({(u.get('handoff') or {}).get('reason')})" if u.get('status') == 'blocked' else "")
                  for u in units.values() if u.get("status") in ("active", "stale", "blocked")]
    if unfinished:
        return (False, "unit(s) not finished: " + "; ".join(unfinished) +
                " — hand each off as READY, or `eaos unit cancel --reason` if it is out of "
                "scope", [], [])
    live_builds = [u for u in units.values()
                   if u.get("kind") == "build" and u.get("status") != "cancelled"]
    if live_builds:
        cfg = load_config() if os.path.isfile(config_path()) else DEFAULT_CONFIG
        current = compute_snapshot(cfg)
        for cat in cfg.get("required_checks", []):
            status, rec = evidence_status(state, cat, current)
            if status != "pass":
                waived_here = any(cat in (u.get("handoff") or {}).get("waived", [])
                                  for u in units.values() if u.get("status") == "ready")
                if waived_here:
                    continue   # surfaced as CONDITIONAL below
                return (False, f"required '{cat}' evidence is {status} for the current code "
                        f"(snapshot {snapshot_short(current)}) — evidence recorded against "
                        f"earlier code is void; re-run `eaos check`", [], [])
        pass
    if open_risks:
        return (False, "high RISK(s) without a verdict: " + ", ".join(open_risks) +
                " — test each (verify --criterion R-<msg> --verdict verified|failed) or "
                "defer honestly (blocked|manual_confirmation_required); 'follow-up' is not "
                "a verdict", [], [])
    manual = [k for k, v in criteria.items() if v["verdict"] == MANUAL_CONFIRMATION_VERDICT]
    unresolved = [k for k, v in criteria.items() if v["verdict"] in UNRESOLVED_VERDICTS]
    return True, None, manual, unresolved

def waived_units(state):
    """Structured waiver records (v4 review 2, finding 1): a required check waived at a
    READY handoff. Kept SEPARATE from criterion ids so consumers never index criteria by
    a waiver string. A waiver is a conditional outcome, never a pass; every consumer of
    require_status must also consult this."""
    out = []
    for u in (state.get("units", {}) or {}).values():
        h = u.get("handoff") or {}
        if u.get("status") == "ready" and h.get("waived"):
            out.append({"unit": u["id"], "waived": list(h["waived"]),
                        "reason": h.get("waive_reason"), "at": h.get("at")})
    return out

def print_criteria_table(state):
    criteria = state.get("criteria", {})
    print("| Criterion | Verdict | Evidence |")
    print("|---|---|---|")
    for k, v in criteria.items():
        print(f"| {k} | {v['verdict']} | {v['evidence']} |")

def parse_bulk_verify_lines(text):
    """Each line: CRITERION | VERDICT | EVIDENCE. VERDICT accepts the canonical enum
    (verified|failed|blocked|not_reproducible|manual_confirmation_required) plus the
    legacy pass/fail aliases (fix 3) — aliases are canonicalized here before being
    returned, so callers only ever see/persist canonical values."""
    parsed = []
    errors = []
    for i, raw in enumerate(text.splitlines(), start=1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = [p.strip() for p in line.split("|")]
        if len(parts) != 3 or not all(parts):
            errors.append((i, raw))
            continue
        criterion, verdict, evidence = parts
        if verdict not in VERIFY_VERDICTS:
            errors.append((i, raw))
            continue
        parsed.append((criterion, canonicalize_verdict(verdict), evidence))
    return parsed, errors

def cmd_verify(args):
    if args.require:
        state = load_state(args.id)
        ok, reason, manual, unresolved = require_status(state)
        waivers = waived_units(state)
        print_criteria_table(state)
        if not ok:
            print(f"UNVERIFIED: {reason}")
            sys.exit(1)
        for w in waivers:
            print(f"CONDITIONAL: {w['unit']} waived required check(s) {w['waived']} at handoff "
                  f"— {w['reason']}; not a verified outcome")
        if manual or unresolved or waivers:
            # fix 2: name which class each conditional criterion belongs to — the two
            # classes carry different honesty semantics, never collapse them together.
            for k in manual:
                print(f"CONDITIONAL: {k} (manual_confirmation_required) — implementation "
                      f"may be complete; release pending human confirmation")
            for k in unresolved:
                verdict = state["criteria"][k]["verdict"]
                print(f"CONDITIONAL: {k} ({verdict}) — implementation NOT claimed "
                      f"complete; criterion unresolved")
            sys.exit(3)
        print("OK: all recorded criteria pass")
        sys.exit(0)

    if args.bulk:
        text = sys.stdin.read()
        parsed, errors = parse_bulk_verify_lines(text)
        if errors:
            print("MALFORMED bulk verify input — nothing recorded:")
            for lineno, raw in errors:
                print(f"  line {lineno}: {raw}")
            sys.exit(2)
        with task_lock(args.id):
            state = load_state(args.id)
            # fix 5: one idempotency key covers the whole batch — a replay returns the
            # cached output and appends nothing a second time. fix A: the key is bound
            # to a fingerprint of the raw bulk input itself (the body), so the same key
            # reused with different bulk content is a conflict, not a silent replay.
            fp = compute_request_fingerprint("verify --bulk", args.id, body_text=text)
            idempotency_guard(state, args.idempotency_key, fp, "verify --bulk", args.id)
            if state.get("status") == "blocked":
                ensure_not_blocked(state, args.id)

            for criterion, verdict, evidence in parsed:
                reject_deferral_evidence(criterion, verdict, evidence)
            ts = now_iso()
            for criterion, verdict, evidence in parsed:
                state.setdefault("criteria", {})[criterion] = {
                    "verdict": verdict, "evidence": evidence, "at": ts,
                    "seq": next_seq(state)}
                warroom_log(args.id, f"[{ts}] VERIFY criterion={criterion} "
                                      f"verdict={verdict} evidence={evidence}")
            out = f"OK: {len(parsed)} criteria recorded via --bulk"
            idempotency_record(state, args.idempotency_key, fp, out)
            save_state(args.id, state)
        print(out)
        sys.exit(0)

    if not args.criterion or not args.verdict:
        die("verify: need --criterion NAME --verdict verified|failed|blocked|"
            "not_reproducible|manual_confirmation_required (aliases pass->verified, "
            "fail->failed accepted) --evidence '...', or --require, or --bulk", 2)
    if not args.evidence:
        die("verify: --evidence is mandatory with --verdict (an unevidenced pass is "
            "exactly the fantasy this tool exists to kill)", 2)

    verdict = canonicalize_verdict(args.verdict)
    reject_deferral_evidence(args.criterion, verdict, args.evidence)
    with task_lock(args.id):
        state = load_state(args.id)
        fp = compute_request_fingerprint(
            "verify", args.id,
            [("criterion", args.criterion), ("verdict", verdict),
             ("evidence", args.evidence)],
        )
        idempotency_guard(state, args.idempotency_key, fp, "verify", args.id)
        if state.get("status") == "blocked":
            ensure_not_blocked(state, args.id)

        ts = now_iso()
        state.setdefault("criteria", {})[args.criterion] = {
            "verdict": verdict, "evidence": args.evidence, "at": ts,
            "seq": next_seq(state),
        }
        out = f"OK: {args.criterion} = {verdict}"
        idempotency_record(state, args.idempotency_key, fp, out)
        save_state(args.id, state)
        warroom_log(args.id, f"[{ts}] VERIFY criterion={args.criterion} "
                              f"verdict={verdict} evidence={args.evidence}")
    print(out)
    sys.exit(0)

# ---------- status ----------

def cmd_status(args):
    current = read_current()
    task_id = args.id or current
    if not task_id:
        die("no CURRENT task set — pass an id: eaos status <id>", 2)
    state = load_state(task_id)
    cfg_path = config_path()
    cfg = json.load(open(cfg_path, encoding="utf-8")) if os.path.isfile(cfg_path) \
        else DEFAULT_CONFIG
    if getattr(args, "packet", False):
        print_packet(task_id, state, cfg)
        sys.exit(0)

    print(f"Task: {state['id']} — {state['title']}")
    print(f"CURRENT: {current}" if current else "CURRENT: (none)")
    print(f"Status: {state['status']}   Phase: {state['phase']}")
    if state.get("status") == "blocked" and state.get("blocked"):
        b = state["blocked"]
        print(f"  BLOCKED: issue={b.get('issue')} reason={b.get('reason')} at={b.get('at')}")
    history = " -> ".join(h["phase"] for h in state["phase_history"])
    print(f"Phase history: {history}")
    if read_episode_lines_for_task(state["id"]):
        print("episode: closed")

    spawns = state["spawns"]
    print(f"Spawns: {spawns['count']}/{cfg['max_agent_spawns_per_task']}")

    lb = state["loopbacks"]
    print(f"Loopbacks: total {lb['total']}/{cfg['max_total_loopbacks']}; "
          f"by issue: {lb['by_issue']}")

    print("Gates:")
    if not state.get("gates"):
        print("  (none recorded)")
    for phase, checks in state.get("gates", {}).items():
        for name, r in checks.items():
            print(f"  {phase}/{name}: {r['result']}")

    print("Criteria:")
    if state.get("criteria"):
        print_criteria_table(state)
    else:
        print("  (none recorded)")

    print("Last 5 war-room messages:")
    for m in state["messages"][-5:]:
        print(f"  {m['id']} [{m['type']}] {m['from']} -> {', '.join(m['to'])}: {m['body']}")
    sys.exit(0)

# ---------- report ----------

def cmd_report(args):
    # fix 5: report is idempotent BY CONSTRUCTION — it deterministically overwrites the
    # same artifacts/final-report.md path from the current state, so no idempotency key
    # is needed (re-running it with unchanged state reproduces the same file byte-for-
    # byte). It still takes the task lock while writing so a concurrent mutation can't
    # interleave with the read-state-then-write-file sequence.
    with task_lock(args.id):
        state = load_state(args.id)
        ok, reason, manual, unresolved = require_status(state)
        if not ok:
            print(f"REFUSED: verify --require not satisfied — {reason}")
            sys.exit(1)

        d = task_dir(args.id)
        artifacts_dir = os.path.join(d, "artifacts")
        os.makedirs(artifacts_dir, exist_ok=True)
        out_path = os.path.join(artifacts_dir, "final-report.md")

        lines = [f"# Final report skeleton — {state['id']}: {state['title']}", ""]

        lines.append("## Phase history")
        for h in state["phase_history"]:
            lines.append(f"- {h['phase']} ({h['at']})")
        lines.append("")

        waivers = waived_units(state)
        if waivers:
            lines.append("## Waived required checks (CONDITIONAL — not verified)")
            for w in waivers:
                lines.append(f"- {w['unit']}: {', '.join(w['waived'])} waived at handoff "
                             f"({w['at']}) — {w['reason']}")
            lines.append("")

        lines.append("## Decisions")
        decisions = [m for m in state["messages"] if m["type"] == "DECISION"]
        if decisions:
            for m in decisions:
                lines.append(f"- [{m['id']}] {m['from']}: {m['body']}")
        else:
            lines.append("(none recorded)")
        lines.append("")

        lines.append("## Criteria (DoD table)")
        lines.append("| Criterion | Verdict | Evidence |")
        lines.append("|---|---|---|")
        for k, v in state.get("criteria", {}).items():
            lines.append(f"| {k} | {v['verdict']} | {v['evidence']} |")
        lines.append("")

        # fix 2: manual_confirmation_required and blocked/not_reproducible get separate
        # subsections — they carry different honesty semantics and must never be
        # collapsed into one "conditional" bucket.
        if manual:
            lines.append("### Pending manual confirmation")
            for k in manual:
                v = state["criteria"][k]
                lines.append(f"- {k}: {v['verdict']} — {v['evidence']}")
            lines.append("")

        if unresolved:
            lines.append("### Unresolved (blocked / not reproducible)")
            for k in unresolved:
                v = state["criteria"][k]
                lines.append(f"- {k}: {v['verdict']} — {v['evidence']}")
            lines.append("")

        ledger = state["loopbacks"]["ledger"]
        if ledger:
            lines.append("## Attempt ledger")
            for e in ledger:
                lines.append(f"- issue={e['issue']} edge={e['edge']}: {e['attempt']}")
            lines.append("")

        lines.append("## Artifacts")
        for name in sorted(os.listdir(artifacts_dir)):
            if name != "final-report.md":
                lines.append(f"- artifacts/{name}")
        lines.append("")

        # fix 2: never emit "implementation complete" when a blocked/not_reproducible
        # criterion exists — that phrase is reserved for the all-verified or
        # manual-confirmation-only cases (law 7: no unconditional completion claim while
        # required criteria remain unverified).
        if unresolved:
            unresolved_desc = "; ".join(
                f"{k} ({state['criteria'][k]['verdict']})" for k in unresolved)
            lines.append(f"Conditional result — NOT claiming implementation complete. "
                          f"Unresolved: {unresolved_desc}")
            lines.append("")
        elif manual:
            lines.append(f"implementation complete; release pending manual confirmation "
                          f"of: {', '.join(manual)}")
            lines.append("")

        with open(out_path, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")

    print(f"OK: report skeleton written to {out_path}")
    sys.exit(0)

# ---------- episode ----------

def cmd_episode_close(args):
    with project_lock():
        with task_lock(args.id):
            state = load_state(args.id)
            fp = compute_request_fingerprint("episode close", args.id,
                                              [("amend", args.amend)])
            idempotency_guard(state, args.idempotency_key, fp, "episode close", args.id)

            existing = read_episode_lines_for_task(args.id)
            if existing and not args.amend:
                die("already closed — use --amend to append a corrected line", 1)

            ts = now_iso()
            created = state.get("created")

            phases = [h["phase"] for h in state.get("phase_history", [])]

            agents = []
            for s in state.get("spawns", {}).get("log", []):
                name = s.get("agent")
                if name not in agents:
                    agents.append(name)

            loopbacks = state.get("loopbacks", {})

            gates_summary = {}
            for phase, checks in state.get("gates", {}).items():
                passed = sum(1 for r in checks.values() if r["result"] == "pass")
                failed = sum(1 for r in checks.values() if r["result"] != "pass")
                gates_summary[phase] = {"pass": passed, "fail": failed}

            criteria_state = state.get("criteria", {})
            criteria = {k: v["verdict"] for k, v in criteria_state.items()}
            criteria_total = len(criteria)
            criteria_verified = sum(1 for v in criteria.values() if v == "verified")
            has_fail = any(v == "failed" for v in criteria.values())
            has_unresolved = any(v in UNRESOLVED_VERDICTS for v in criteria.values())
            has_manual = any(v == MANUAL_CONFIRMATION_VERDICT for v in criteria.values())

            # fix 2: verdict enum expanded beyond verified/partial/unverified —
            # conditional-manual is distinguished from partial because a
            # manual_confirmation_required-only result may still be implementation-
            # complete (release just needs a human's sign-off), while partial
            # (any blocked/not_reproducible, no fails) means it is not.
            # ONE authoritative verdict calculation (v4 spec, runtime contract R-1):
            # require_status() is what `verify --require` and `report` consume, so the
            # episode record must be derived from it too. Reproduced 2026-09-17: a task
            # with an open high RISK was refused by verify/report and still closed as
            # "verified" because this block only looked at criteria verdicts.
            ok_req, req_reason, manual_keys, unresolved_keys = require_status(state)
            waivers = waived_units(state)
            if not ok_req:
                verdict = "unverified"
            elif unresolved_keys:
                verdict = "partial"
            elif manual_keys or waivers:
                verdict = "conditional-manual"
            else:
                verdict = "verified"

            wall_seconds = None
            try:
                wall_seconds = (datetime.datetime.fromisoformat(ts) -
                                 datetime.datetime.fromisoformat(created)).total_seconds()
            except (TypeError, ValueError):
                wall_seconds = None  # created missing/unparseable — never guess

            close_revision = 1
            if existing:
                close_revision = max(e.get("close_revision", 1) for e in existing) + 1

            # fix B: read-check-append within the lock — refuse rather than ever writing
            # two runs.jsonl lines for the same (task, close_revision) pair. With
            # close_revision always computed as max(existing)+1 immediately above, this
            # can only fire if `existing` itself is inconsistent (e.g. a hand-edited or
            # externally-tampered runs.jsonl) — exactly the case this defends against,
            # since the alternative would be silently appending a colliding duplicate.
            if any(e.get("close_revision") == close_revision for e in existing):
                die(f"REFUSED: a runs.jsonl line for ({args.id}, "
                    f"close_revision={close_revision}) already exists — refusing to "
                    f"write a duplicate", 1)

            episode = {
                "schema_version": 1,
                "task": args.id,
                "title": state.get("title"),
                "kind": state.get("kind"),
                "stakes": state.get("stakes"),
                "playbook": state.get("playbook"),
                "created": created,
                "closed": ts,
                "phases": phases,
                "spawns": state.get("spawns", {}).get("count", 0),
                "agents": agents,
                "loopbacks_total": loopbacks.get("total", 0),
                "loopbacks_by_issue": loopbacks.get("by_issue", {}),
                "gates": gates_summary,
                "criteria": criteria,
                "criteria_verified": criteria_verified,
                "criteria_total": criteria_total,
                "verdict": verdict,
                "tokens": "unavailable",  # the CLI cannot see host token counts; never infer
                "wall_seconds": wall_seconds,
                "close_revision": close_revision,
            }

            # single os.write append of one line — atomic enough for local single-line
            # appends; the project lock is what actually serializes concurrent closers.
            line = (json.dumps(episode) + "\n").encode("utf-8")
            fd = os.open(runs_path(), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
            try:
                os.write(fd, line)
            finally:
                os.close(fd)

            state["status"] = "closed"
            out = f"OK: {args.id} closed (verdict={verdict}, close_revision={close_revision})"
            idempotency_record(state, args.idempotency_key, fp, out)
            save_state(args.id, state)
            clear_current_if_matches(args.id)  # M-007: release the global pointer
            retarget_session_maps_on_close(args.id, state.get("parent"))

            warroom_log(args.id, f"[{ts}] EPISODE closed verdict={verdict} "
                                  f"close_revision={close_revision}")
    print(out)
    sys.exit(0)

# ---------- audit ----------

def cmd_audit(args):
    # Coherent snapshot (review round 4 HIGH-1): every input the checks compare is read
    # under project lock -> task lock (the canonical order every mutating verb uses), so
    # a legitimate concurrent mutation can never land between two of our reads and
    # masquerade as drift. The checks themselves run after both locks are released.
    cfg = load_config()
    task_dir(args.id)
    with project_lock():
        with task_lock(args.id):
            with open(state_path(args.id), "rb") as f:
                state_bytes = f.read()
            state = migrate_state(json.loads(state_bytes.decode("utf-8")))
            warroom_text = read_warroom_text(args.id)
            parsed_eps, malformed_lines = scan_runs_jsonl_for_task(args.id)
            journal_path = revisions_path(args.id)
            journal_raw = None
            if os.path.isfile(journal_path):
                with open(journal_path, encoding="utf-8") as f:
                    journal_raw = f.read()
            snap = audit_task_snapshot()
            heads = read_heads_for_task(args.id)
            lock_events = read_lock_events()
    checks = []

    def add(name, ok, detail):
        checks.append({"name": name, "ok": ok, "detail": detail})

    # (a) spawns recorded vs distinct agent-ish names appearing in warroom SPAWN lines,
    # and (best-effort) any "Task("/"Agent(" mentions that might indicate untracked
    # spawns (this is exactly the eval-run leak: 16 real spawns, 10 recorded).
    n_state_spawns = state.get("spawns", {}).get("count", 0)
    warroom_spawn_lines = [ln for ln in warroom_text.splitlines()
                            if re.search(r"\bSPAWN agent=", ln) and "REJECTED" not in ln]
    n_warroom_spawns = len(warroom_spawn_lines)
    task_agent_mentions = len(re.findall(r"\b(?:Task|Agent)\(", warroom_text))
    a_ok = (n_state_spawns == n_warroom_spawns) and (task_agent_mentions <= n_state_spawns)
    add("spawns_vs_warroom", a_ok,
        f"state={n_state_spawns} warroom_spawn_lines={n_warroom_spawns} "
        f"task/agent_mentions={task_agent_mentions}")

    # (b) phase INTAKE while spawns/criteria/gates already exist
    has_progress = (n_state_spawns > 0 or bool(state.get("criteria")) or
                    bool(state.get("gates")))
    b_ok = not (state.get("phase") == "INTAKE" and has_progress)
    add("phase_intake_consistency", b_ok,
        f"phase={state.get('phase')} spawns={n_state_spawns} "
        f"criteria={len(state.get('criteria', {}))} gates={len(state.get('gates', {}))}")

    # (c) messages count 0 while warroom has protocol "### " or "- id: msg-" entries
    has_msg_evidence = bool(re.search(r"^### ", warroom_text, re.M) or
                             re.search(r"- id: msg-", warroom_text))
    c_ok = not (len(state.get("messages", [])) == 0 and has_msg_evidence)
    add("messages_vs_warroom", c_ok,
        f"messages={len(state.get('messages', []))} warroom_has_msg_entries={has_msg_evidence}")

    # (d) episode closed but state not status=closed, and vice versa
    episode_closed = bool(parsed_eps)
    state_closed = state.get("status") == "closed"
    d_ok = episode_closed == state_closed
    add("episode_vs_status", d_ok,
        f"episode_closed={episode_closed} state_status={state.get('status')}")

    # (o) DONE without an episode: the run record (M-008) is what every later
    # evaluation reads; a task at phase DONE with no `eaos episode close` has finished its
    # work and skipped its evidence. Real run 2026-09-09: 3 of 3 tasks. Surfaced here so
    # the Stop hook makes the close mechanical instead of optional.
    o_bad = (state.get("phase") == "DONE" and not episode_closed
             and state.get("status") != "closed")
    add("done_without_episode_close", not o_bad,
        f"phase=DONE but no episode line — run `eaos episode close {args.id}`" if o_bad
        else "none")

    # (p) checker role folded into the orchestrator (real run 2026-09-09: "Security
    # RE-REVIEW folded: orchestrator performs the mechanical diff check", "design-phase
    # security relay FOLDED", verifier's re-grade run by the orchestrator). A checker whose
    # work the maker performs is not a checker. The war room is prose, so this is a
    # heuristic like check (e): FOLD/FOLDED within 80 chars of a checker role name.
    fold_hits = []
    for ln in warroom_text.splitlines():
        if re.search(r"\bFOLD(ED|S|ING)?\b", ln, re.I) and CHECKER_ROLE_RE.search(ln):
            fold_hits.append(ln.strip()[:120])
    add("checker_role_folded", not fold_hits,
        f"{len(fold_hits)} line(s) fold a checker role into the maker (maker=checker): "
        f"{fold_hits[:3]}" if fold_hits else "none")

    # (e) unresolved same-issue loop counters at/over ceiling without a BLOCKED/deadlock
    # note (a hard_blocker ledger entry, or a DEADLOCK/BLOCKED mention, for that issue)
    max_same = cfg["max_same_issue_loops"]
    by_issue = state.get("loopbacks", {}).get("by_issue", {})
    ledger = state.get("loopbacks", {}).get("ledger", [])
    e_bad = []
    for issue, n in by_issue.items():
        if n >= max_same:
            noted = any(e["issue"] == issue and e.get("class") == "hard_blocker"
                        for e in ledger)
            noted = noted or (f"issue '{issue}'" in warroom_text and
                               ("DEADLOCK" in warroom_text or "BLOCKED" in warroom_text))
            if not noted:
                e_bad.append(issue)
    add("loop_ceiling_without_note", not e_bad,
        f"issues_at_ceiling_without_note={e_bad}" if e_bad else "none")

    # (f) stale lock files (should never survive a clean run — a leftover one means a
    # process died mid-mutation, or a real bug)
    stale = []
    for lock_path in (os.path.join(task_dir(args.id), ".lock"),
                       os.path.join(eaos_dir(), ".lock")):
        if os.path.isfile(lock_path):
            age = time.time() - os.path.getmtime(lock_path)
            if age > LOCK_STALE_SECONDS:
                stale.append((lock_path, round(age)))
    add("stale_locks", not stale, f"stale={stale}" if stale else "none")

    # (m) lock steals (round 5 item 6): a stolen stale lock means an eaos process died
    # mid-mutation — the state it was writing may be inconsistent, so "stealing with a
    # warning" is not enough; it stays a discrepancy until a human reviews the state and
    # acknowledges with `eaos append <id> --from human --to orchestrator --type STATUS
    # --body "lock-steal-ack: <what was checked>"`.
    # Project-lock steals count against every task that was active at the time.
    created_at = state.get("created") or ""
    relevant_steals = [e for e in lock_events
                       if e.get("task") == args.id
                       or (e.get("task") is None and str(e.get("at", "")) >= created_at)]
    acknowledged = "lock-steal-ack" in warroom_text
    m_ok = not relevant_steals or acknowledged
    add("lock_steals", m_ok,
        "none" if not relevant_steals else
        (f"{len(relevant_steals)} steal(s) acknowledged" if acknowledged else
         f"{len(relevant_steals)} unacknowledged stale-lock steal(s): "
         f"{[(e.get('at'), e.get('path')) for e in relevant_steals]}"))

    # (g) revision present and monotonic (v2 files) — a single snapshot can only check
    # presence/validity, not history, but a missing/invalid revision is itself the bug.
    sv = state.get("schema_version")
    rev = state.get("revision")
    g_ok = True
    if sv is not None and sv >= 2:
        g_ok = isinstance(rev, int) and rev >= 1
    add("revision_present", g_ok, f"schema_version={sv} revision={rev}")

    # (h) criteria contain verdict values outside the canonical enum. Persisted state
    # must always be canonical (verified/failed/blocked/not_reproducible/
    # manual_confirmation_required) — pass/fail aliases are input-only (fix 3) and must
    # never survive to state.json, so this checks against CANONICAL_VERDICTS, not the
    # alias-inclusive VERIFY_VERDICTS accepted at the CLI boundary.
    bad_verdicts = [k for k, v in state.get("criteria", {}).items()
                     if v.get("verdict") not in CANONICAL_VERDICTS]
    add("criteria_verdict_enum", not bad_verdicts,
        f"bad={bad_verdicts}" if bad_verdicts else "none")

    # (i) fix 1: a hard_blocker ledger entry implies the task should have transitioned
    # to status=blocked (see cmd_loopback) — status=active with such an entry is a
    # discrepancy (e.g. a state file written before this fix, or a bug). Likewise
    # status=blocked with no "blocked" record is internally inconsistent.
    ledger_all = state.get("loopbacks", {}).get("ledger", [])
    has_hard_blocker_entry = any(e.get("class") == "hard_blocker" for e in ledger_all)
    status = state.get("status")
    i_bad = []
    if has_hard_blocker_entry and status == "active":
        i_bad.append("hard_blocker ledger entry present while status=active")
    if status == "blocked" and not state.get("blocked"):
        i_bad.append("status=blocked with no blocked record")
    add("hard_blocker_state_consistency", not i_bad,
        "; ".join(i_bad) if i_bad else "none")

    # (j) fix B: runs.jsonl reconciliation for this task — duplicate (task,
    # close_revision) pairs, a close_revision sequence that isn't strictly increasing in
    # file order, gaps in the 1..N contiguous revision numbering, and malformed lines
    # that still reference this task. (state.status == "closed" with zero episode lines,
    # or the reverse, is already covered by check (d) episode_vs_status above — not
    # duplicated here.)
    revisions = [e.get("close_revision") for e in parsed_eps]
    j_bad = []

    counts = {}
    for r in revisions:
        counts[r] = counts.get(r, 0) + 1
    dup_revs = sorted((r for r, c in counts.items() if c > 1), key=lambda x: (x is None, x))
    if dup_revs:
        j_bad.append(f"duplicate close_revision(s): {dup_revs}")

    if any(a is None or b is None or a >= b for a, b in zip(revisions, revisions[1:])):
        j_bad.append(f"close_revision not strictly increasing in file order: {revisions}")

    uniq_sorted = sorted(r for r in revisions if r is not None)
    uniq_sorted = sorted(set(uniq_sorted))
    if uniq_sorted and uniq_sorted != list(range(1, len(uniq_sorted) + 1)):
        j_bad.append(f"close_revision gap(s): have {uniq_sorted}, expected "
                     f"1..{len(uniq_sorted)}")

    if malformed_lines:
        j_bad.append("malformed runs.jsonl line(s) referencing this task: lines "
                     f"{[ln for ln, _ in malformed_lines]}")

    add("runs_jsonl_consistency", not j_bad, "; ".join(j_bad) if j_bad else "none")

    # (k) parent-tree budget/topology consistency (spec §11) — under the project lock,
    # locate this task's root and traverse all descendants (a single scan of every
    # .eaos/T-*/state.json parent field). Flags a dangling parent reference (points at a
    # task id that doesn't exist), a cycle (a task reachable from itself via parent
    # pointers), and a persisted tree-wide spawns.count total over the configured cap.
    root = audit_locate_root(args.id, snap) if args.id in snap else args.id
    tree = audit_tree_members(root, snap)

    dangling = []
    for tid in tree:
        parent = snap.get(tid, {}).get("parent")
        if parent is not None and parent not in snap:
            dangling.append(tid)
    dangling.sort()
    cycle_members = set()
    for tid in tree:
        cyc = audit_find_cycle(tid, snap)
        if cyc:
            cycle_members.update(cyc)

    cap = cfg["max_agent_spawns_per_task"]
    total = sum(snap[tid]["spawns"] for tid in tree if tid in snap)

    k_bad = []
    if dangling:
        k_bad.append(f"dangling parent ref(s): {dangling}")
    if cycle_members:
        k_bad.append(f"cycle detected among: {sorted(cycle_members)}")
    if total > cap:
        k_bad.append(f"tree spawn total {total} exceeds cap {cap} (root={root}, "
                     f"members={sorted(tree)})")
    k_detail = (f"root={root} total={total}/{cap} members={sorted(tree)}"
                if not k_bad else "; ".join(k_bad))
    add("parent_tree_budget_consistency", not k_bad, k_detail)

    # (l) revision journal monotonicity (spec §11) — cross-check .eaos/<id>/
    # revisions.jsonl (appended by save_state on every successful mutation, per fix L)
    # against the live state.json. Flags: state.revision regressed below the journal's
    # max recorded revision; the journal not strictly increasing by exactly 1 (gaps or
    # duplicates); the latest journal state_sha256 not matching sha256 of the current
    # state.json bytes (tamper/corruption/out-of-band edit — intended to fire on a
    # manual state.json edit); and malformed journal lines. A task with no journal yet
    # (it predates this feature and hasn't been mutated since) is ok, not a discrepancy.
    # A task carrying the journal_enabled genesis marker (written by every save_state)
    # with no journal or an empty one has lost history — that IS a discrepancy; only a
    # task without the marker is a legacy pre-journal task (round 4 medium-1).
    journal_enabled = bool(state.get("journal_enabled"))
    l_bad = []
    l_note = None
    if journal_raw is None:
        if journal_enabled:
            l_bad.append("journal missing for a journal-enabled task "
                         "(revisions.jsonl deleted?)")
        else:
            l_note = "no journal yet (pre-journal task)"
    else:
        entries = []
        malformed_journal = []
        if True:
            for lineno, raw in enumerate(journal_raw.splitlines(), start=1):
                raw = raw.strip()
                if not raw:
                    continue
                try:
                    obj = json.loads(raw)
                    rev = obj["revision"]
                    sha = obj["state_sha256"]
                    if not isinstance(rev, int) or not isinstance(sha, str):
                        raise ValueError("bad journal entry types")
                except (json.JSONDecodeError, KeyError, TypeError, ValueError):
                    malformed_journal.append(lineno)
                    continue
                entries.append({"revision": rev, "state_sha256": sha})

        if malformed_journal:
            l_bad.append(f"malformed journal line(s): {malformed_journal}")
        if not entries and not malformed_journal and journal_enabled:
            l_bad.append("journal empty for a journal-enabled task "
                         "(revisions.jsonl truncated?)")

        if entries:
            revs = [e["revision"] for e in entries]
            if any(revs[i + 1] != revs[i] + 1 for i in range(len(revs) - 1)):
                l_bad.append(f"journal revisions not strictly increasing by 1: {revs}")

            journal_max = max(revs)
            state_rev = state.get("revision")
            if isinstance(state_rev, int) and state_rev < journal_max:
                l_bad.append(f"state.revision {state_rev} < journal max {journal_max} "
                             f"(regression)")

            current_sha = hashlib.sha256(state_bytes).hexdigest()
            if entries[-1]["state_sha256"] != current_sha:
                l_bad.append("latest journal state_sha256 does not match current "
                             "state.json (tamper/corruption/out-of-band edit)")

            start = state.get("journal_start_revision")
            if isinstance(start, int):
                if revs[0] != start:
                    l_bad.append(f"journal head truncated: first line is revision "
                                 f"{revs[0]}, journal_start_revision={start}")
            if revs[0] != 1:
                l_note = f"journal started at revision {revs[0]}"

    l_detail = "; ".join(l_bad) if l_bad else (l_note or "clean")
    add("revision_monotonicity", not l_bad, l_detail)

    # (n) project head anchor (round 5 item 3): .eaos/heads.jsonl holds every (revision,
    # sha) this task ever saved, OUTSIDE the task directory. The latest head must equal
    # the live state; a coordinated rollback of state.json + revisions.jsonl inside
    # .eaos/<id>/ therefore still shows as drift. Tasks written before the anchor existed
    # (no journal_start_revision marker) are noted, not flagged.
    n_bad = []
    n_note = None
    anchored = isinstance(state.get("journal_start_revision"), int)
    head_revs = [h.get("revision") for h in heads]
    if any(not isinstance(r, int) for r in head_revs):
        n_bad.append("malformed head entry (non-integer revision)")
    elif not heads:
        if anchored:
            n_bad.append("no project head recorded for an anchored task (heads.jsonl "
                         "missing or scrubbed?)")
        else:
            n_note = "no project head yet (pre-anchor task)"
    else:
        if any(head_revs[i + 1] <= head_revs[i] for i in range(len(head_revs) - 1)):
            n_bad.append(f"project heads not strictly increasing: {head_revs}")
        latest = heads[-1]
        state_rev = state.get("revision")
        if isinstance(state_rev, int) and state_rev < latest["revision"]:
            n_bad.append(f"state.revision {state_rev} < project head {latest['revision']} "
                         f"(rollback — state and journal restored together?)")
        elif isinstance(state_rev, int) and state_rev > latest["revision"]:
            n_bad.append(f"state.revision {state_rev} > project head {latest['revision']} "
                         f"(state advanced without a recorded save)")
        elif latest.get("state_sha256") != hashlib.sha256(state_bytes).hexdigest():
            n_bad.append("project head sha256 does not match current state.json")
    add("project_head_anchor", not n_bad, "; ".join(n_bad) if n_bad else (n_note or "clean"))

    discrepancies = [c for c in checks if not c["ok"]]

    if args.json:
        print(json.dumps({"task": args.id, "checks": checks,
                           "discrepancy_count": len(discrepancies)}, indent=2))
    else:
        print(f"Audit: {args.id}")
        for c in checks:
            status = "ok" if c["ok"] else "DISCREPANCY"
            print(f"  [{status}] {c['name']}: {c['detail']}")
        print(f"{len(discrepancies)} discrepancy(ies) found" if discrepancies else "clean")
    sys.exit(1 if discrepancies else 0)

# ---------- session (review round 4 HIGH-4) ----------

def cmd_session(args):
    sid = args.session or os.environ.get("EAOS_SESSION_ID") or None
    if args.session_cmd == "bind":
        check_session_id(sid)
        with project_lock():
            state = load_state(args.id)
            if state.get("status") == "closed":
                die(f"cannot bind session to closed task {args.id}", 1)
            if args.fresh:
                # The PostToolUse binder's path (round 5 item 2): command text and stdout
                # are untrusted, so the CLI only accepts a bind that is consistent with
                # "this session just created this task": the task is recent and no OTHER
                # session already claims it. A crafted `echo "eaos task new"; echo T-001`
                # therefore cannot hijack an established task.
                try:
                    created = datetime.datetime.fromisoformat(state.get("created", ""))
                    age = (datetime.datetime.now() - created).total_seconds()
                except (TypeError, ValueError):
                    age = float("inf")
                if age > SESSION_BIND_FRESH_SECONDS or age < 0:
                    die(f"refusing --fresh bind: {args.id} was created {age:.0f}s ago "
                        f"(limit {SESSION_BIND_FRESH_SECONDS}s)", 1)
                owners = [o for o, t in all_session_maps().items() if t == args.id and o != sid]
                if owners:
                    die(f"refusing --fresh bind: {args.id} is already bound to session(s) "
                        f"{owners}", 1)
            write_session_map(sid, args.id)
        print(f"OK: session {sid} -> {args.id}")
    elif args.session_cmd == "unbind":
        check_session_id(sid)
        with project_lock():
            remove_session_map(sid)
        print(f"OK: session {sid} unbound")
    else:  # resolve — the hook's single entry point; exit 1 (printed reason) = fail open
        if sid:
            check_session_id(sid)
        with project_lock():
            tid, reason = resolve_hook_task(sid)
        if not tid:
            die(f"no task for hook: {reason}", 1)
        print(tid)
    sys.exit(0)

# ---------- v4 runtime: snapshot, check evidence, units, board, writer lease, packet ----------
# Spec: docs/specs/2026-09-17-eaos-v4-architecture.md sections 5-9. Every contract here is
# a boundary the model cannot talk its way through; none of it prescribes reasoning.

SNAPSHOT_EXCLUDE_DIRS = (".eaos",)
CHECK_CATEGORIES = ("test", "lint", "type", "build", "rehearsal", "other")
BOARD_TYPES = ("claim", "finding", "decision", "risk", "question")
BOARD_STATUSES = ("active", "resolved", "disproven", "superseded")
BOARD_SUMMARY_MAX = 400
UNIT_KINDS = ("build", "read", "check")

def _run(cmd, cwd=None, timeout=None, shell=False):
    return subprocess.run(cmd, cwd=cwd or os.getcwd(), shell=shell, capture_output=True,
                          text=True, timeout=timeout)

def _git(*args):
    try:
        r = _run(["git", *args])
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None

def compute_snapshot(cfg=None):
    """Identity of the PRODUCT inputs (v4 R-2): HEAD, tracked modifications, and untracked
    non-ignored files. Excluded: .eaos/ (runtime records: recording a check must never
    change the identity of the code it verified) and everything git ignores (build
    outputs, caches). Ignored-but-relevant paths are opted in via config
    snapshot_extra_paths. Not a git repo -> hashes the tree the same way with HEAD='nogit'."""
    h = hashlib.sha256()
    ignore = (cfg or {}).get("snapshot_ignore_globs") or DEFAULT_CONFIG["snapshot_ignore_globs"]

    def noise(p):
        parts = p.split("/")
        return any(fnmatch.fnmatch(part, g) for part in parts for g in ignore)

    head = _git("rev-parse", "HEAD")
    if head is None or _git("rev-parse", "--is-inside-work-tree") is None:
        # Not a git repository (v4 review 1, finding 4): a deterministic walk of the tree,
        # same exclusions, so an edit to any product file changes the identity. Slower
        # than the git path, and stated as such in the adapter table.
        h.update(b"nogit-tree\n")
        for root, dirs, files in os.walk(os.getcwd()):
            rel_root = os.path.relpath(root, os.getcwd())
            dirs[:] = sorted(d for d in dirs
                             if d not in SNAPSHOT_EXCLUDE_DIRS and d != ".git" and not noise(d))
            for name in sorted(files):
                rel = name if rel_root == "." else os.path.join(rel_root, name)
                if noise(rel):
                    continue
                h.update(f"\n--{rel}--\n".encode("utf-8", "surrogatepass"))
                try:
                    with open(os.path.join(root, name), "rb") as f:
                        h.update(f.read())
                except OSError:
                    h.update(b"<unreadable>")
        return h.hexdigest()

    h.update(head.strip().encode())
    diff = _git("diff", "HEAD", "--", ".", *[f":!{d}" for d in SNAPSHOT_EXCLUDE_DIRS])
    if diff is None:
        diff = _git("diff", "--", ".", *[f":!{d}" for d in SNAPSHOT_EXCLUDE_DIRS]) or ""
    h.update(diff.encode("utf-8", "surrogatepass"))
    untracked = _git("ls-files", "--others", "--exclude-standard") or ""
    paths = [p for p in untracked.splitlines()
             if p and not any(p == d or p.startswith(d + "/") for d in SNAPSHOT_EXCLUDE_DIRS)
             and not noise(p)]
    extra = (cfg or {}).get("snapshot_extra_paths") or []
    for p in sorted(set(paths) | {e for e in extra if os.path.isfile(e)}):
        h.update(f"\n--{p}--\n".encode())
        try:
            with open(p, "rb") as f:
                h.update(f.read())
        except OSError:
            h.update(b"<unreadable>")
    return h.hexdigest()

def snapshot_short(s):
    return (s or "")[:12]

def _scope_overlaps(a, b):
    """Deterministic scope match (P-5): empty scope is global and overlaps everything; two
    glob lists overlap when any pattern of one matches any pattern of the other."""
    if not a or not b:
        return True
    for x in a:
        for y in b:
            if x == y or fnmatch.fnmatch(x, y) or fnmatch.fnmatch(y, x):
                return True
            xp, yp = x.rstrip("*/"), y.rstrip("*/")
            if xp and yp and (xp.startswith(yp) or yp.startswith(xp)):
                return True
    return False

def _split_scope(text):
    return [s.strip() for s in (text or "").split(",") if s.strip()]

def board_of(state):
    return state.setdefault("board", {"revision": 0, "entries": {}})

def units_of(state):
    return state.setdefault("units", {})

# ---- snapshot

def cmd_snapshot(args):
    cfg = load_config() if os.path.isfile(config_path()) else DEFAULT_CONFIG
    print(compute_snapshot(cfg))
    sys.exit(0)

# ---- check evidence (R-2, R-3)

def cmd_check(args):
    cfg = load_config()
    if args.category not in CHECK_CATEGORIES:
        die(f"check: --category must be one of {', '.join(CHECK_CATEGORIES)}", 2)
    if bool(args.cmd) == bool(args.unavailable):
        die("check: need exactly one of --cmd '<shell>' or --unavailable --reason '<why>'", 2)
    if args.unavailable and not args.reason:
        die("check: --unavailable requires --reason", 2)
    with task_lock(args.id):
        state = load_state(args.id)
        if state.get("status") == "blocked":
            ensure_not_blocked(state, args.id)
        ts = now_iso()
        seq = next_seq(state)
        rec = {"seq": seq, "category": args.category, "unit": args.unit, "at": ts,
               "cwd": os.getcwd()}
        if args.unavailable:
            rec.update({"unavailable": True, "reason": args.reason, "exit": None,
                        "snapshot_before": compute_snapshot(cfg), "snapshot_after": None,
                        "stable": None, "output_ref": None, "cmd": None})
            passed = True
        else:
            before = compute_snapshot(cfg)
            try:
                r = _run(args.cmd, shell=True, timeout=args.timeout)
                out = (r.stdout or "") + (("\n[stderr]\n" + r.stderr) if r.stderr else "")
                code = r.returncode
            except subprocess.TimeoutExpired:
                out, code = f"[timeout after {args.timeout}s]", 124
            after = compute_snapshot(cfg)
            cdir = os.path.join(task_dir(args.id), "checks")
            os.makedirs(cdir, exist_ok=True)
            ref = os.path.join(cdir, f"{seq:04d}-{args.category}.log")
            with open(ref, "w", encoding="utf-8") as f:
                f.write(f"$ {args.cmd}\n# cwd={os.getcwd()} exit={code} "
                        f"snapshot_before={before} snapshot_after={after}\n\n{out}")
            rec.update({"cmd": args.cmd, "exit": code, "snapshot_before": before,
                        "snapshot_after": after, "stable": before == after,
                        "output_ref": os.path.relpath(ref), "unavailable": False,
                        "reason": None})
            passed = code == 0
        state.setdefault("checks", []).append(rec)
        save_state(args.id, state)
        warroom_log(args.id, f"[{ts}] CHECK category={args.category} "
                              f"{'UNAVAILABLE' if args.unavailable else 'exit=' + str(rec['exit'])} "
                              f"snapshot={snapshot_short(rec['snapshot_before'])} "
                              f"stable={rec['stable']} unit={args.unit or '-'}")
    if args.unavailable:
        print(f"OK: check {args.category} recorded UNAVAILABLE ({args.reason})")
        sys.exit(0)
    if not rec["stable"]:
        print(f"CHECK exit={rec['exit']} but SNAPSHOT-UNSTABLE: the command changed product "
              f"files ({snapshot_short(rec['snapshot_before'])} -> "
              f"{snapshot_short(rec['snapshot_after'])}); this evidence binds to neither "
              f"snapshot. Commit or revert the change, then re-run the check")
        sys.exit(1)
    print(f"{'OK' if passed else 'CHECK FAILED'}: {args.category} exit={rec['exit']} "
          f"snapshot={snapshot_short(rec['snapshot_before'])} log={rec['output_ref']}")
    sys.exit(0 if passed else 1)

def latest_evidence(state, category, current_snapshot):
    """The LATEST record of this category made against the current snapshot, whatever its
    result (v4 review 1, finding 2: searching backwards for any historical pass let a
    newer failure be ignored). Records against other snapshots are void (R-3)."""
    for rec in reversed(state.get("checks", [])):
        if rec.get("category") != category:
            continue
        bound = rec.get("snapshot_after") if not rec.get("unavailable") else rec.get("snapshot_before")
        if bound == current_snapshot:
            return rec
    return None

def evidence_status(state, category, current_snapshot):
    """-> ("pass", rec) | ("fail", rec) | ("unavailable", rec) | ("unstable", rec) | ("none", None).
    Only "pass" satisfies a required check. An unavailable record explains a BLOCKED or
    waived handoff; it never counts as passing (finding 1)."""
    rec = latest_evidence(state, category, current_snapshot)
    if rec is None:
        return "none", None
    if rec.get("unavailable"):
        return "unavailable", rec
    if not rec.get("stable"):
        return "unstable", rec
    return ("pass" if rec.get("exit") == 0 else "fail"), rec

def valid_evidence(state, category, current_snapshot):
    status, rec = evidence_status(state, category, current_snapshot)
    return rec if status == "pass" else None

# ---- units (P-1, P-4, R-4)

def cmd_unit(args):
    cfg = load_config()
    # Canonical lock order project -> task, taken BEFORE the first mutation (v4 review 2,
    # finding 2: a blocked handoff saved task state, then blocked on the project lock while
    # releasing the workspace pen — exit 4 "nothing mutated" after mutating). Lock
    # contention now exits 4 before any write; the lease release below runs under the
    # project lock already held.
    with project_lock(), task_lock(args.id):
        state = load_state(args.id)
        if state.get("status") == "blocked":
            ensure_not_blocked(state, args.id)
        units = units_of(state)
        ts = now_iso()
        if args.unit_cmd == "start":
            if args.kind not in UNIT_KINDS:
                die(f"unit start: --kind must be one of {', '.join(UNIT_KINDS)}", 2)
            uid = f"U-{len(units) + 1:03d}"
            units[uid] = {"id": uid, "title": args.title, "kind": args.kind,
                          "scope": _split_scope(args.scope), "status": "active",
                          "board_rev": board_of(state)["revision"],
                          "snapshot": compute_snapshot(cfg), "started": ts,
                          "seq": next_seq(state), "reconciled": [], "stale_by": None,
                          "handoff": None}
            save_state(args.id, state)
            warroom_log(args.id, f"[{ts}] UNIT START {uid} kind={args.kind} "
                                  f"board_rev={units[uid]['board_rev']} "
                                  f"snapshot={snapshot_short(units[uid]['snapshot'])} "
                                  f"scope={units[uid]['scope']} title={args.title}")
            print(uid)
            sys.exit(0)

        u = units.get(args.uid)
        if not u:
            die(f"no such unit: {args.uid}", 2)
        if args.unit_cmd == "cancel":
            if not args.reason:
                die("unit cancel: --reason is required (an explicit, auditable disposition)", 2)
            u["status"] = "cancelled"
            u["handoff"] = {"kind": "cancelled", "reason": args.reason, "at": ts,
                            "seq": next_seq(state)}
            save_state(args.id, state)
            release_workspace_writer(args.id, args.uid)
            warroom_log(args.id, f"[{ts}] UNIT CANCEL {args.uid}: {args.reason}")
            print(f"OK: {args.uid} cancelled ({args.reason})")
            sys.exit(0)
        if args.unit_cmd == "handoff":
            if bool(args.ready) == bool(args.blocked):
                die("unit handoff: need exactly one of --ready or --blocked --reason", 2)
            if args.blocked:
                if not args.reason:
                    die("unit handoff: --blocked requires --reason", 2)
                u["status"] = "blocked"
                u["handoff"] = {"kind": "blocked", "reason": args.reason, "at": ts,
                                "seq": next_seq(state)}
                save_state(args.id, state)
                release_workspace_writer(args.id, args.uid)   # a blocked holder keeps no pen
                warroom_log(args.id, f"[{ts}] UNIT HANDOFF {args.uid} BLOCKED: {args.reason}")
                print(f"OK: {args.uid} handed off as BLOCKED (requesting help) — this is not a "
                      f"success claim")
                sys.exit(0)
            # --ready: evidence + reconciliation + not stale
            problems = []
            if u.get("status") == "stale":
                problems.append(f"unit is STALE (invalidated by {u.get('stale_by')}); "
                                f"reconcile it first")
            current = compute_snapshot(cfg)
            waived = []
            for cat in cfg.get("required_checks", []):
                if u.get("kind") != "build":
                    break
                status, rec = evidence_status(state, cat, current)
                if status == "pass":
                    continue
                if cat in _split_scope(args.waive):
                    if not args.reason:
                        die("unit handoff: --waive requires --reason", 2)
                    waived.append(cat)
                    continue
                detail = {"none": "no check recorded against the current code",
                          "fail": f"the latest '{cat}' check FAILED (exit {rec.get('exit') if rec else '?'})",
                          "unavailable": f"'{cat}' is recorded UNAVAILABLE ({rec.get('reason') if rec else ''}) — "
                                         f"that explains a --blocked handoff or an explicit "
                                         f"--waive {cat} --reason, it is not a pass",
                          "unstable": f"the latest '{cat}' check changed product files"}[status]
                problems.append(f"required '{cat}' evidence for snapshot "
                                f"{snapshot_short(current)}: {detail}")
            pending = unreconciled_entries(state, u)
            if pending:
                problems.append("unreconciled in-scope board changes since this unit "
                                f"started: {[e['id'] for e in pending]} — "
                                f"`eaos board reconcile` each")
            if problems:
                print("HANDOFF REFUSED (not ready):")
                for p in problems:
                    print(f"  - {p}")
                print("A blocked handoff is always available: --blocked --reason '<why>'")
                sys.exit(1)
            u["status"] = "ready"
            u["handoff"] = {"kind": "ready", "at": ts, "snapshot": current,
                            "seq": next_seq(state), "waived": waived,
                            "waive_reason": args.reason if waived else None}
            save_state(args.id, state)
            release_workspace_writer(args.id, args.uid)
            warroom_log(args.id, f"[{ts}] UNIT HANDOFF {args.uid} READY snapshot="
                                  f"{snapshot_short(current)}"
                                  + (f" WAIVED={waived} reason={args.reason}" if waived else ""))
            print(f"OK: {args.uid} READY for review at snapshot {snapshot_short(current)}"
                  + (f" — WAIVED {waived} (auditable; completion will be CONDITIONAL)" if waived else ""))
            sys.exit(0)

def unreconciled_entries(state, unit):
    out = []
    for e in board_of(state)["entries"].values():
        if e["revision"] <= unit.get("board_rev", 0):
            continue
        if e.get("unit") == unit["id"]:
            continue
        if e.get("status") != "active":
            continue
        if e["id"] in unit.get("reconciled", []):
            continue
        if not _scope_overlaps(e.get("scope"), unit.get("scope")):
            continue
        out.append(e)
    return out

# ---- board (section 5, P-2, P-3)

def cmd_board(args):
    cfg = load_config()
    if args.board_cmd == "view":
        state = load_state(args.id)
        rc = print_board_view(state, cfg, args)
        sys.exit(rc)
    if args.board_cmd == "diff":
        state = load_state(args.id)
        scope = _split_scope(args.scope)
        if args.unit:
            u = units_of(state).get(args.unit)
            if not u:
                die(f"no such unit: {args.unit}", 2)
            scope = scope or u.get("scope")
            since = args.since if args.since is not None else u.get("board_rev", 0)
        else:
            since = args.since or 0
        hits = [e for e in board_of(state)["entries"].values()
                if e["revision"] > since and _scope_overlaps(e.get("scope"), scope)]
        hits.sort(key=lambda e: e["revision"])
        print(f"board changes since revision {since}: {len(hits)}")
        for e in hits:
            print(_fmt_entry(e))
        sys.exit(0)

    with task_lock(args.id):
        state = load_state(args.id)
        if state.get("status") == "blocked":
            ensure_not_blocked(state, args.id)
        board = board_of(state)
        ts = now_iso()
        if args.board_cmd == "post":
            if args.type not in BOARD_TYPES:
                die(f"board post: --type must be one of {', '.join(BOARD_TYPES)}", 2)
            summary = (args.summary or "").strip()
            if not summary:
                die("board post: --summary is required", 2)
            if len(summary) > BOARD_SUMMARY_MAX:
                die(f"board post: summary is {len(summary)} chars; the limit is "
                    f"{BOARD_SUMMARY_MAX}. Put the detail in an artifact and pass --ref", 2)
            severity = None
            if args.type == "risk":
                severity = resolve_risk_severity(args.severity, None, summary)
                if severity is None:
                    die("board post: a risk needs --severity low|medium|high|blocking", 2)
            fp = compute_request_fingerprint(
                "board post", args.id,
                [("type", args.type), ("ref", args.ref), ("scope", args.scope),
                 ("severity", severity), ("unit", args.unit), ("supersedes", args.supersedes),
                 ("invalidates", args.invalidates)], body_text=summary)
            idempotency_guard(state, args.idempotency_key, fp, "board post", args.id)
            eid = f"B-{len(board['entries']) + 1:03d}"
            board["revision"] += 1
            unit = units_of(state).get(args.unit) if args.unit else None
            entry = {"id": eid, "revision": board["revision"], "type": args.type,
                     "summary": summary, "ref": args.ref,
                     "scope": _split_scope(args.scope) or (unit.get("scope") if unit else []),
                     "severity": severity,
                     "author": args.author or (args.unit or "lead"), "unit": args.unit,
                     "snapshot": compute_snapshot(cfg), "status": "active", "at": ts,
                     "seq": next_seq(state), "supersedes": args.supersedes,
                     "invalidates": args.invalidates}
            board["entries"][eid] = entry
            if args.supersedes:
                t = board["entries"].get(args.supersedes)
                if not t:
                    die(f"board post: --supersedes {args.supersedes}: no such entry", 2)
                t["status"] = "superseded"
                t["revision"] = board["revision"]
            if args.invalidates:
                target_u = units_of(state).get(args.invalidates)
                target_e = board["entries"].get(args.invalidates)
                if target_u:
                    if target_u.get("status") in ("active", "ready"):
                        target_u["status"] = "stale"
                        target_u["stale_by"] = eid
                elif target_e:
                    target_e["status"] = "disproven"
                    target_e["revision"] = board["revision"]
                else:
                    die(f"board post: --invalidates {args.invalidates}: no such unit or "
                        f"entry", 2)
            if args.type == "risk" and severity in RISK_REGISTERED_SEVERITIES:
                state.setdefault("open_risks", []).append(
                    {"msg": eid, "at": ts, "seq": next_seq(state),
                     "from": entry["author"], "severity": severity})
            out = f"OK: {eid} posted (rev {board['revision']})"
            idempotency_record(state, args.idempotency_key, fp, out)
            save_state(args.id, state)
            warroom_log(args.id, f"[{ts}] BOARD {eid} {args.type} rev={board['revision']} "
                                  f"by={entry['author']} sev={severity or '-'} "
                                  f"scope={entry['scope']} "
                                  f"{'supersedes=' + args.supersedes + ' ' if args.supersedes else ''}"
                                  f"{'invalidates=' + args.invalidates + ' ' if args.invalidates else ''}"
                                  f":: {summary}")
            print(out)
            sys.exit(0)
        if args.board_cmd == "resolve":
            e = board["entries"].get(args.eid)
            if not e:
                die(f"no such entry: {args.eid}", 2)
            if args.status not in BOARD_STATUSES:
                die(f"board resolve: --status must be one of {', '.join(BOARD_STATUSES)}", 2)
            e["status"] = args.status
            board["revision"] += 1
            e["revision"] = board["revision"]
            save_state(args.id, state)
            warroom_log(args.id, f"[{ts}] BOARD {args.eid} -> {args.status} "
                                  f"rev={board['revision']}")
            print(f"OK: {args.eid} {args.status} (rev {board['revision']})")
            sys.exit(0)
        if args.board_cmd == "reconcile":
            u = units_of(state).get(args.uid)
            if not u:
                die(f"no such unit: {args.uid}", 2)
            e = board["entries"].get(args.entry)
            if not e:
                die(f"no such entry: {args.entry}", 2)
            if args.disposition not in ("acted", "not-applicable"):
                die("board reconcile: --disposition acted|not-applicable", 2)
            if args.disposition == "not-applicable" and not args.note:
                die("board reconcile: not-applicable requires --note '<why>'", 2)
            if args.entry not in u["reconciled"]:
                u["reconciled"].append(args.entry)
            if u.get("stale_by") == args.entry:
                u["stale_by"] = None
                u["status"] = "active"
            save_state(args.id, state)
            warroom_log(args.id, f"[{ts}] RECONCILE {args.uid} {args.entry} "
                                  f"{args.disposition}{(' — ' + args.note) if args.note else ''}")
            print(f"OK: {args.uid} reconciled {args.entry} ({args.disposition})")
            sys.exit(0)

def _fmt_entry(e):
    sev = f" [{e['severity']}]" if e.get("severity") else ""
    ref = f" -> {e['ref']}" if e.get("ref") else ""
    st = "" if e.get("status") == "active" else f" ({e['status']})"
    return f"{e['id']} r{e['revision']} {e['type']}{sev} by {e['author']}{st}: {e['summary']}{ref}"

def print_board_view(state, cfg, args):
    """Deterministic, budgeted (5.3). Blocking risks and active decisions first; a view
    NEVER silently omits a blocking fact — if those alone exceed the budget it says so
    and exits 3."""
    budgets = cfg.get("board_view_budget", {})
    budget = args.budget or budgets.get(args.for_, 1500)
    scope = _split_scope(args.scope)
    if args.unit:
        u = units_of(state).get(args.unit)
        if u and not scope:
            scope = u.get("scope")
    entries = [e for e in board_of(state)["entries"].values()
               if e.get("status") == "active" and _scope_overlaps(e.get("scope"), scope)]
    if args.for_ == "checker":
        entries = [e for e in entries if e["type"] != "claim"]   # K-1: no maker claims

    def tier(e):
        if e["type"] == "risk" and e.get("severity") == "blocking":
            return 0
        if e["type"] == "decision":
            return 1
        if e["type"] == "risk" and e.get("severity") == "high":
            return 2
        return 3
    entries.sort(key=lambda e: (tier(e), -e["revision"]))
    lines, used, omitted_blocking, omitted_other = [], 0, [], 0
    for e in entries:
        line = _fmt_entry(e)
        cost = len(line) // 4 + 1
        if used + cost > budget:
            if tier(e) <= 2:
                omitted_blocking.append(e["id"])
            else:
                omitted_other += 1
            continue
        lines.append(line)
        used += cost
    print(f"board view for={args.for_} rev={board_of(state)['revision']} "
          f"budget={budget} used~{used} scope={scope or 'all'}")
    for ln in lines:
        print(ln)
    rc = 0
    if omitted_blocking:
        print(f"INCOMPLETE: {len(omitted_blocking)} blocking/decision entries omitted: "
              f"{omitted_blocking} — retrieve them; this view is not complete")
        rc = 3
    if omitted_other:
        print(f"({omitted_other} more entries not shown; raise --budget or narrow --scope)")
    return rc

# ---- writer lease (R-5) — WORKSPACE scope: .eaos/writer.json under the project lock.
# v4 review 1, finding 5: a per-task field let two tasks in one directory both hold "the"
# pen. The owner is (task, unit). A blocked, cancelled or ready handoff releases it;
# an abandoned holder is released with --force --reason, which is logged to both tasks.

def writer_path():
    return os.path.join(eaos_dir(), "writer.json")

def read_writer():
    p = writer_path()
    if not os.path.isfile(p):
        return None
    try:
        with open(p, encoding="utf-8") as f:
            return json.load(f) or None
    except (OSError, json.JSONDecodeError):
        return None

def write_writer(obj):
    p = writer_path()
    tmp = f"{p}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, indent=2)
    os.replace(tmp, p)

def release_workspace_writer(task_id, unit_id):
    """Drops the workspace lease if (task, unit) holds it. Caller MUST already hold the
    project lock (cmd_unit takes project -> task before any mutation); this helper takes
    no lock of its own. Crash between the task-state write and this removal leaves a
    lease held by a non-active unit; cmd_writer treats such a holder as stale and
    recovers it (logged)."""
    w = read_writer()
    if w and w.get("task") == task_id and w.get("unit") == unit_id:
        try:
            os.remove(writer_path())
        except OSError:
            pass

def cmd_writer(args):
    ts = now_iso()
    with project_lock():
        w = read_writer()
        if args.writer_cmd == "claim":
            with task_lock(args.id):
                state = load_state(args.id)
                if args.unit not in units_of(state):
                    die(f"no such unit: {args.unit}", 2)
                if w and (w.get("task"), w.get("unit")) != (args.id, args.unit):
                    # crash-recovery: a holder whose unit is no longer active (blocked,
                    # ready, cancelled) cannot legitimately hold the pen
                    stale = False
                    try:
                        hstate = load_state(w["task"]) if w.get("task") != args.id else state
                        hunit = (hstate.get("units") or {}).get(w.get("unit"), {})
                        stale = hunit.get("status") not in ("active", "stale")
                    except SystemExit:
                        stale = True   # holder task no longer exists
                    if stale:
                        warroom_log(args.id, f"[{ts}] WRITER recovered stale lease from "
                                             f"{w.get('task')}/{w.get('unit')} (holder not active)")
                        w = None
                if w and (w.get("task"), w.get("unit")) != (args.id, args.unit):
                    print(f"WRITER HELD by {w['task']}/{w['unit']} since {w['at']} "
                          f"(scope {w.get('scope')}) — one writer per workspace; wait for its "
                          f"handoff, or `eaos writer release {w['task']} --unit {w['unit']} "
                          f"--force --reason '<why>'` if it is abandoned")
                    sys.exit(1)
                lease = {"task": args.id, "unit": args.unit, "at": ts,
                         "seq": next_seq(state), "scope": _split_scope(args.scope),
                         "cwd": os.getcwd()}
                write_writer(lease)
                state["writer"] = {"unit": args.unit, "at": ts, "scope": lease["scope"]}
                save_state(args.id, state)
                warroom_log(args.id, f"[{ts}] WRITER {args.unit} claimed workspace "
                                      f"scope={lease['scope']}")
            print(f"OK: writer lease -> {args.id}/{args.unit}")
            sys.exit(0)
        if args.writer_cmd == "release":
            if not w:
                die("writer release: no lease is held", 1)
            holder = (w.get("task"), w.get("unit"))
            if holder != (args.id, args.unit) and not args.force:
                die(f"writer release: lease held by {holder[0]}/{holder[1]}, not "
                    f"{args.id}/{args.unit} — use --force --reason to recover an abandoned "
                    f"lease", 1)
            if args.force and not args.reason:
                die("writer release: --force requires --reason", 2)
            try:
                os.remove(writer_path())
            except OSError:
                pass
            for tid in {holder[0], args.id}:
                if tid and os.path.isdir(os.path.join(eaos_dir(), tid)):
                    warroom_log(tid, f"[{ts}] WRITER {holder[0]}/{holder[1]} released"
                                     + (f" by FORCE from {args.id}/{args.unit}: {args.reason}"
                                        if args.force else ""))
            print(f"OK: writer lease released ({holder[0]}/{holder[1]})"
                  + (" by force" if args.force else ""))
            sys.exit(0)
        print(f"writer: {w['task'] + '/' + w['unit'] if w else '(none)'}")
        sys.exit(0)

# ---- context record (C-4, advisory)

def cmd_ctx(args):
    with task_lock(args.id):
        state = load_state(args.id)
        c = state.setdefault("context", {"last": 0, "max": 0, "at": None, "samples": 0})
        c["last"] = int(args.tokens)
        c["max"] = max(c["max"], int(args.tokens))
        c["at"] = now_iso()
        c["samples"] = c.get("samples", 0) + 1
        save_state(args.id, state)
    cfg = load_config()
    ceiling = int(cfg.get("max_context_tokens", 0) or 0)
    if ceiling and int(args.tokens) > ceiling:
        print(f"CONTEXT {int(args.tokens):,} > ceiling {ceiling:,} — reset at the next unit "
              f"boundary: `eaos status --packet` then a fresh session (advisory: the host "
              f"cannot be forced to reset)")
        sys.exit(3)
    print(f"OK: context {int(args.tokens):,} recorded")
    sys.exit(0)

# ---- continuation packet (C-2)

def print_packet(task_id, state, cfg):
    print("=== EAOS CONTINUATION PACKET ===")
    print(f"task: {task_id} — {state.get('title')}   kind={state.get('kind')} "
          f"stakes={state.get('stakes')} status={state.get('status')}")
    head = (_git("rev-parse", "--short", "HEAD") or "nogit").strip()
    print(f"code: HEAD {head}, snapshot {snapshot_short(compute_snapshot(cfg))}, "
          f"board rev {board_of(state)['revision']}")
    criteria = state.get("criteria", {})
    if criteria:
        print("criteria:")
        for k, v in list(criteria.items())[:15]:
            print(f"  {k}: {v['verdict']}")
        if len(criteria) > 15:
            print(f"  (+{len(criteria) - 15} more)")
    units = units_of(state)
    live = [u for u in units.values() if u.get("status") in ("active", "stale", "ready")]
    if live:
        print("units:")
        for u in live[:8]:
            print(f"  {u['id']} {u['status']} {u['kind']} scope={u.get('scope')} :: {u['title']}")
    w = read_writer()
    print(f"writer: {w['task'] + '/' + w['unit'] if w else '(none)'}")
    scn = state.get("scenarios", [])
    if scn:
        graded = sum(1 for s in scn if s in state.get("criteria", {}))
        print(f"scenarios: {len(scn)} recorded, {graded} graded (content outside the workspace)")
    class A:  # minimal args shim for the lead view
        for_ = "lead"; budget = int(cfg.get("board_view_budget", {}).get("packet", 800))
        scope = None; unit = None
    print_board_view(state, cfg, A)
    checks = state.get("checks", [])[-3:]
    if checks:
        print("latest checks:")
        for c in checks:
            what = "UNAVAILABLE" if c.get("unavailable") else f"exit={c.get('exit')}"
            print(f"  {c['category']} {what} snapshot={snapshot_short(c.get('snapshot_before'))}"
                  f" stable={c.get('stable')}")
    ok, reason, manual, unresolved = require_status(state)
    waivers = [f"{w['unit']}:{','.join(w['waived'])} waived" for w in waived_units(state)]
    print(f"verdict: {'all recorded criteria pass' if ok else reason}"
          + (f"; conditional: {manual + unresolved + waivers}" if (manual or unresolved or waivers) else ""))
    ctx = state.get("context") or {}
    ceiling = int(cfg.get("max_context_tokens", 0) or 0)
    if ctx.get("last"):
        flag = " OVER CEILING" if ceiling and ctx["last"] > ceiling else ""
        print(f"context: last {ctx['last']:,} max {ctx['max']:,}{flag}")
    nxt = []
    for u in units.values():
        if u.get("status") == "stale":
            nxt.append(f"reconcile {u['id']} (invalidated by {u.get('stale_by')})")
    for u in units.values():
        if u.get("status") == "ready":
            nxt.append(f"check {u['id']} (ready for review)")
    if not ok:
        nxt.append("resolve: " + reason)
    print("next: " + ("; ".join(nxt) if nxt else "continue the current unit"))
    print("=== END PACKET ===")

# ---------- evaluator scenarios (v4 spec K-2, K-3) ----------
# Scenarios are end-to-end expectations written from DISCLOSED requirements before any
# builder runs. They live OUTSIDE the workspace (the builder's tools reach the workspace;
# keeping them elsewhere is the practical boundary — advisory, section 11) under a
# per-workspace directory, and each one is a criterion the checker must grade by
# execution before `verify --require` passes. A scenario revealed by a failure becomes
# regression coverage and is marked so; it is no longer an untouched holdout.

def scenarios_root():
    base = os.environ.get("EAOS_SCENARIO_HOME") or os.path.join(
        os.path.expanduser(os.environ.get("CLAUDE_HOME", "~/.claude")), "eaos", "scenarios")
    ws = hashlib.sha256(os.getcwd().encode("utf-8", "surrogatepass")).hexdigest()[:12]
    return os.path.join(base, ws)

def scenarios_path(task_id):
    return os.path.join(scenarios_root(), f"{task_id}.json")

def load_scenarios(task_id):
    p = scenarios_path(task_id)
    if not os.path.isfile(p):
        return []
    with open(p, encoding="utf-8") as f:
        return json.load(f)

def save_scenarios(task_id, items):
    os.makedirs(scenarios_root(), exist_ok=True)
    try:
        os.chmod(scenarios_root(), 0o700)
    except OSError:
        pass
    p = scenarios_path(task_id)
    tmp = f"{p}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(items, f, indent=2)
    os.replace(tmp, p)
    try:
        os.chmod(p, 0o600)
    except OSError:
        pass

def cmd_scenario(args):
    task_dir(args.id)
    items = load_scenarios(args.id)
    if args.scenario_cmd == "add":
        for field in ("given", "when", "then"):
            if not getattr(args, field):
                die("scenario add: --given, --when and --then are all required (an "
                    "end-to-end expectation, not a test name)", 2)
        sid = f"S-{len(items) + 1:03d}"
        items.append({"id": sid, "title": args.title, "given": args.given, "when": args.when,
                      "then": args.then, "requirement": args.requirement, "at": now_iso(),
                      "revealed": None})
        save_scenarios(args.id, items)
        with task_lock(args.id):
            state = load_state(args.id)
            state.setdefault("scenarios", []).append(sid)
            save_state(args.id, state)
            warroom_log(args.id, f"[{now_iso()}] SCENARIO {sid} recorded (content held outside "
                                  f"the workspace) requirement={args.requirement or '-'}")
        print(sid)
        sys.exit(0)
    if args.scenario_cmd == "list":
        if not items:
            print("no scenarios recorded for this task")
            sys.exit(0)
        state = load_state(args.id)
        criteria = state.get("criteria", {})
        for s in items:
            if args.revealed and not s.get("revealed"):
                continue
            v = criteria.get(s["id"], {}).get("verdict", "ungraded")
            print(f"{s['id']} [{v}]{' REVEALED ' + s['revealed'] if s.get('revealed') else ''}: "
                  f"{s['title']}")
            if args.full or args.for_ == "checker":
                print(f"  given: {s['given']}\n  when:  {s['when']}\n  then:  {s['then']}"
                      + (f"\n  requirement: {s['requirement']}" if s.get("requirement") else ""))
        sys.exit(0)
    if args.scenario_cmd == "grade":
        sid = args.sid
        sc = next((s for s in items if s["id"] == sid), None)
        if not sc:
            die(f"no such scenario: {sid}", 2)
        verdict = canonicalize_verdict(args.verdict)
        if verdict not in CANONICAL_VERDICTS:
            die(f"scenario grade: --verdict must be one of {', '.join(CANONICAL_VERDICTS)}", 2)
        if not args.evidence:
            die("scenario grade: --evidence is mandatory (what was executed and what happened)", 2)
        reject_deferral_evidence(sid, verdict, args.evidence)
        with task_lock(args.id):
            state = load_state(args.id)
            ts = now_iso()
            state.setdefault("criteria", {})[sid] = {
                "verdict": verdict, "evidence": args.evidence, "at": ts,
                "seq": next_seq(state), "scenario": True}
            if verdict == "failed" and not sc.get("revealed"):
                sc["revealed"] = ts     # a failure reveals it to the maker: regression from now on
                save_scenarios(args.id, items)
            save_state(args.id, state)
            warroom_log(args.id, f"[{ts}] SCENARIO {sid} graded {verdict}"
                                  f"{' (revealed)' if verdict == 'failed' else ''} evidence={args.evidence}")
        print(f"OK: {sid} = {verdict}" + (" — revealed; now regression coverage, no longer a holdout"
                                          if verdict == "failed" else ""))
        sys.exit(0)

# ---------- argparse wiring ----------

def build_parser():
    p = argparse.ArgumentParser(prog="eaos")
    sub = p.add_subparsers(dest="cmd", required=True)

    p_init = sub.add_parser("init")
    p_init.add_argument("--max-spawns", type=int, default=None)
    p_init.add_argument("--max-same-issue", type=int, default=None)
    p_init.add_argument("--max-total-loopbacks", type=int, default=None)
    p_init.add_argument("--reserve-verifier", type=int, default=None, dest="reserve_verifier",
                        help="spawn slots at the top of the cap only a verifier may use "
                             "(default 1)")
    p_init.add_argument("--reserve-loopbacks", type=int, default=None, dest="reserve_loopbacks",
                        help="spawn slots that open only after a loop-back is recorded "
                             "(default 2) — a roster is planned within cap minus reserves")
    p_init.set_defaults(func=cmd_init)

    p_task = sub.add_parser("task")
    task_sub = p_task.add_subparsers(dest="task_cmd", required=True)
    p_task_new = task_sub.add_parser("new")
    p_task_new.add_argument("title")
    p_task_new.add_argument("--kind", default=None)
    p_task_new.add_argument("--stakes", default=None,
                            choices=["toy", "internal", "production"])
    p_task_new.add_argument("--playbook", default=None)
    p_task_new.add_argument("--parent", default=None)
    p_task_new.add_argument("--paths", default=None,
                            help="comma-separated target paths/symbols, used in the "
                                 "fingerprint and the overlap-warning Jaccard score")
    p_task_new.add_argument("--criteria", default=None,
                            help="comma-separated criteria ids (e.g. AC-1,AC-2), used in "
                                 "the fingerprint and the overlap-warning Jaccard score")
    p_task_new.add_argument("--outcome", default=None,
                            help="free-text intended outcome, used in the fingerprint "
                                 "only (not the overlap-warning score)")
    p_task_new.add_argument("--allow-duplicate", action="store_true", dest="allow_duplicate")
    p_task_new.add_argument("--session", default=None,
                            help="host session id to bind to this task (.eaos/sessions/"
                                 "<id>); defaults to $EAOS_SESSION_ID when set")
    p_task_new.add_argument("--reason", default=None)
    p_task_new.add_argument("--idempotency-key", dest="idempotency_key", default=None)
    p_task_new.set_defaults(func=cmd_task_new)

    p_append = sub.add_parser("append")
    p_append.add_argument("id")
    p_append.add_argument("--from", dest="frm", required=True)
    p_append.add_argument("--to", required=True)
    p_append.add_argument("--type", required=True, choices=MSG_TYPES)
    p_append.add_argument("--body", default=None)
    p_append.add_argument("--file", default=None)
    p_append.add_argument("--ref", default=None)
    p_append.add_argument("--priority", default="normal")
    p_append.add_argument("--severity", default=None,
                          help="RISK only: low|medium|high|blocking. high and blocking open "
                               "an R-<msg-id> slot that verify --require demands a verdict for")
    p_append.add_argument("--idempotency-key", dest="idempotency_key", default=None)
    p_append.set_defaults(func=cmd_append)

    p_phase = sub.add_parser("phase")
    p_phase.add_argument("id")
    p_phase.add_argument("phase")
    p_phase.add_argument("--unblock", action="store_true",
                         help="clear a BLOCKED status (from a hard_blocker loopback) and "
                              "record the unblock reason; requires --reason")
    p_phase.add_argument("--reason", default=None, help="required with --unblock")
    p_phase.add_argument("--idempotency-key", dest="idempotency_key", default=None)
    p_phase.set_defaults(func=cmd_phase)

    p_spawn = sub.add_parser("spawn")
    p_spawn.add_argument("id")
    p_spawn.add_argument("--agent", required=True)
    p_spawn.add_argument("--idempotency-key", dest="idempotency_key", default=None)
    p_spawn.set_defaults(func=cmd_spawn)

    p_loop = sub.add_parser("loopback")
    p_loop.add_argument("id")
    p_loop.add_argument("--edge", required=True)
    p_loop.add_argument("--issue", required=True)
    p_loop.add_argument("--attempt", required=True)
    p_loop.add_argument("--class", dest="klass", choices=LOOPBACK_CLASSES, default=None)
    p_loop.add_argument("--idempotency-key", dest="idempotency_key", default=None)
    p_loop.set_defaults(func=cmd_loopback)

    p_gate = sub.add_parser("gate")
    p_gate.add_argument("id")
    p_gate.add_argument("phase")
    p_gate.add_argument("--check", default=None)
    p_gate.add_argument("--pass", dest="passed", action="store_true")
    p_gate.add_argument("--fail", dest="failed", action="store_true")
    p_gate.add_argument("--note", default=None)
    p_gate.add_argument("--require", action="store_true")
    p_gate.add_argument("--idempotency-key", dest="idempotency_key", default=None)
    p_gate.set_defaults(func=cmd_gate)

    p_verify = sub.add_parser("verify")
    p_verify.add_argument("id")
    p_verify.add_argument("--criterion", default=None)
    p_verify.add_argument("--verdict", default=None, choices=list(VERIFY_VERDICTS),
                          help="canonical: verified|failed|blocked|not_reproducible|"
                               "manual_confirmation_required. Aliases 'pass'->verified "
                               "and 'fail'->failed are accepted for compatibility but "
                               "always persisted as the canonical value (fix 3).")
    p_verify.add_argument("--evidence", default=None)
    p_verify.add_argument("--require", action="store_true")
    p_verify.add_argument("--bulk", action="store_true")
    p_verify.add_argument("--idempotency-key", dest="idempotency_key", default=None)
    p_verify.set_defaults(func=cmd_verify)

    p_status = sub.add_parser("status")
    p_status.add_argument("--packet", action="store_true",
                          help="bounded continuation packet for a fresh context (v4 C-2)")
    p_status.add_argument("id", nargs="?", default=None,
                          help="task id; defaults to .eaos/CURRENT if omitted")
    p_status.set_defaults(func=cmd_status)

    p_report = sub.add_parser("report")
    p_report.add_argument("id")
    p_report.set_defaults(func=cmd_report)

    p_episode = sub.add_parser("episode")
    episode_sub = p_episode.add_subparsers(dest="episode_cmd", required=True)
    p_episode_close = episode_sub.add_parser("close")
    p_episode_close.add_argument("id")
    p_episode_close.add_argument("--amend", action="store_true")
    p_episode_close.add_argument("--idempotency-key", dest="idempotency_key", default=None)
    p_episode_close.set_defaults(func=cmd_episode_close)

    p_session = sub.add_parser("session")
    session_sub = p_session.add_subparsers(dest="session_cmd", required=True)
    for name in ("bind", "unbind", "resolve"):
        sp = session_sub.add_parser(name)
        if name == "bind":
            sp.add_argument("id")
            sp.add_argument("--fresh", action="store_true",
                            help="only bind a recently created task no other session "
                                 "claims (the PostToolUse binder's guard)")
        sp.add_argument("--session", default=None,
                        help="host session id; defaults to $EAOS_SESSION_ID")
        sp.set_defaults(func=cmd_session)

    # ---- v4 verbs
    p_snap = sub.add_parser("snapshot")
    p_snap.set_defaults(func=cmd_snapshot)

    p_check = sub.add_parser("check")
    p_check.add_argument("id")
    p_check.add_argument("--category", required=True)
    p_check.add_argument("--cmd", default=None)
    p_check.add_argument("--unavailable", action="store_true")
    p_check.add_argument("--reason", default=None)
    p_check.add_argument("--unit", default=None)
    p_check.add_argument("--timeout", type=int, default=1800)
    p_check.set_defaults(func=cmd_check)

    p_unit = sub.add_parser("unit")
    unit_sub = p_unit.add_subparsers(dest="unit_cmd", required=True)
    p_us = unit_sub.add_parser("start")
    p_us.add_argument("id")
    p_us.add_argument("--title", required=True)
    p_us.add_argument("--kind", default="build")
    p_us.add_argument("--scope", default=None, help="comma-separated path globs")
    p_us.set_defaults(func=cmd_unit)
    p_uh = unit_sub.add_parser("handoff")
    p_uh.add_argument("id")
    p_uh.add_argument("uid")
    p_uh.add_argument("--ready", action="store_true")
    p_uh.add_argument("--blocked", action="store_true")
    p_uh.add_argument("--reason", default=None)
    p_uh.add_argument("--waive", default=None,
                      help="comma-separated required check categories to waive for THIS "
                           "handoff; needs --reason; auditable; completion becomes CONDITIONAL")
    p_uh.set_defaults(func=cmd_unit)
    p_uc = unit_sub.add_parser("cancel")
    p_uc.add_argument("id")
    p_uc.add_argument("uid")
    p_uc.add_argument("--reason", default=None)
    p_uc.set_defaults(func=cmd_unit)

    p_board = sub.add_parser("board")
    board_sub = p_board.add_subparsers(dest="board_cmd", required=True)
    p_bp = board_sub.add_parser("post")
    p_bp.add_argument("id")
    p_bp.add_argument("--type", required=True)
    p_bp.add_argument("--summary", required=True)
    p_bp.add_argument("--ref", default=None)
    p_bp.add_argument("--scope", default=None)
    p_bp.add_argument("--severity", default=None)
    p_bp.add_argument("--unit", default=None)
    p_bp.add_argument("--author", default=None)
    p_bp.add_argument("--supersedes", default=None)
    p_bp.add_argument("--invalidates", default=None, help="a unit id or an entry id")
    p_bp.add_argument("--idempotency-key", dest="idempotency_key", default=None)
    p_bp.set_defaults(func=cmd_board)
    p_br = board_sub.add_parser("resolve")
    p_br.add_argument("id")
    p_br.add_argument("eid")
    p_br.add_argument("--status", required=True)
    p_br.set_defaults(func=cmd_board)
    p_bv = board_sub.add_parser("view")
    p_bv.add_argument("id")
    p_bv.add_argument("--for", dest="for_", default="lead", choices=["lead", "unit", "checker"])
    p_bv.add_argument("--scope", default=None)
    p_bv.add_argument("--budget", type=int, default=None)
    p_bv.add_argument("--unit", default=None)
    p_bv.set_defaults(func=cmd_board)
    p_bd = board_sub.add_parser("diff")
    p_bd.add_argument("id")
    p_bd.add_argument("--since", type=int, default=None)
    p_bd.add_argument("--scope", default=None)
    p_bd.add_argument("--unit", default=None)
    p_bd.set_defaults(func=cmd_board)
    p_bc = board_sub.add_parser("reconcile")
    p_bc.add_argument("id")
    p_bc.add_argument("uid")
    p_bc.add_argument("--entry", required=True)
    p_bc.add_argument("--disposition", required=True)
    p_bc.add_argument("--note", default=None)
    p_bc.set_defaults(func=cmd_board)

    p_writer = sub.add_parser("writer")
    writer_sub = p_writer.add_subparsers(dest="writer_cmd", required=True)
    for name in ("claim", "release", "show"):
        sp = writer_sub.add_parser(name)
        sp.add_argument("id")
        if name != "show":
            sp.add_argument("--unit", required=True)
        sp.add_argument("--scope", default=None)
        if name == "release":
            sp.add_argument("--force", action="store_true")
            sp.add_argument("--reason", default=None)
        sp.set_defaults(func=cmd_writer)

    p_ctx = sub.add_parser("ctx")
    p_ctx.add_argument("id")
    p_ctx.add_argument("--tokens", type=int, required=True)
    p_ctx.set_defaults(func=cmd_ctx)

    p_scn = sub.add_parser("scenario")
    scn_sub = p_scn.add_subparsers(dest="scenario_cmd", required=True)
    p_sa = scn_sub.add_parser("add")
    p_sa.add_argument("id")
    p_sa.add_argument("--title", required=True)
    p_sa.add_argument("--given", default=None)
    p_sa.add_argument("--when", default=None)
    p_sa.add_argument("--then", default=None)
    p_sa.add_argument("--requirement", default=None,
                      help="the disclosed requirement this scenario tests (never a secret one)")
    p_sa.set_defaults(func=cmd_scenario)
    p_sl = scn_sub.add_parser("list")
    p_sl.add_argument("id")
    p_sl.add_argument("--for", dest="for_", default="lead", choices=["lead", "checker"])
    p_sl.add_argument("--full", action="store_true")
    p_sl.add_argument("--revealed", action="store_true")
    p_sl.set_defaults(func=cmd_scenario)
    p_sg = scn_sub.add_parser("grade")
    p_sg.add_argument("id")
    p_sg.add_argument("sid")
    p_sg.add_argument("--verdict", required=True)
    p_sg.add_argument("--evidence", default=None)
    p_sg.set_defaults(func=cmd_scenario)

    p_audit = sub.add_parser("audit")
    p_audit.add_argument("id")
    p_audit.add_argument("--json", action="store_true")
    p_audit.set_defaults(func=cmd_audit)

    return p

def main():
    parser = build_parser()
    args = parser.parse_args()
    if args.cmd == "task" and args.task_cmd != "new":
        die("usage: eaos task new \"<title>\"", 2)
    if args.cmd == "episode" and args.episode_cmd != "close":
        die("usage: eaos episode close <task-id> [--amend]", 2)
    try:
        args.func(args)
    except SystemExit:
        raise
    except Exception as e:  # unexpected bug, not a defined ceiling/gate outcome
        die(f"ERROR: {e}", 2)

if __name__ == "__main__":
    main()
