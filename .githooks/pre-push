#!/usr/bin/env bash
# EAOS pre-push hook — blocks `git push` unless the FULL test entrypoint passes.
# Runs the same steps as `make test` (make itself may be unavailable, e.g. unaccepted
# Xcode license on macOS), so "validation passed" means exactly what CI will check.
# Enable once with:  git config core.hooksPath .githooks   (or: ./scripts/install-hooks.sh)
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

printf "\033[1;36m[pre-push]\033[0m running the full test entrypoint before push...\n"

fail=0
# Every shell script, discovered — not a hand-maintained list that goes stale.
while IFS= read -r -d '' s; do
  bash -n "$s" || { printf "  syntax error: %s\n" "$s"; fail=1; }
done < <(find . -type f \( -name '*.sh' -o -path './.githooks/*' \) -not -path './vendor/*' -not -path './node_modules/*' -not -path './.git/*' -print0)

if command -v python3 >/dev/null 2>&1; then
  python3 scripts/validate-eaos.py || fail=1
  python3 scripts/eval_check.py   || fail=1
  python3 scripts/test_eaos.py    || fail=1
  bash scripts/test_eaos_hooks.sh || fail=1
else
  # FAIL CLOSED: a "blocking" gate that skips its own checks is a lie. No python3 means the
  # validator, eval check, and runtime tests cannot run — so the push cannot be verified.
  printf "\033[1;31m[pre-push]\033[0m python3 not found — cannot run validator/eval/runtime tests. Gate FAILS CLOSED.\n"
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  printf "\033[1;31m[pre-push] checks failed — push aborted.\033[0m Fix the errors above, then push again.\n"
  printf "            (To bypass in an emergency: git push --no-verify)\n"
  exit 1
fi
printf "\033[0;32m[pre-push] full suite passed — pushing.\033[0m\n"
exit 0
